<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MSTest.WinUI.dll is not a NuGet package of its own: MSTest.TestFramework packs it as a build-time
    payload (buildTransitive/net10.0/ui/winui) that is referenced only by WinUI projects.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(WinUiMinimum)</TargetFrameworks>
    <AssemblyName>MSTest.WinUI</AssemblyName>
    <RootNamespace>Microsoft.VisualStudio.TestTools.UnitTesting</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);TRACE;EXCLUDE_RANGE_INDEX_POLYFILL;EXCLUDE_OS_POLYFILL;WIN_UI</DefineConstants>
    <TargetPlatformVersion>10.0.18362.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\MSTest\TestFramework\TestFramework.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" PrivateAssets="all" />
    <Compile Include="$(RepoRoot)src\Polyfills\**\*.cs" Link="Polyfills\%(RecursiveDir)%(Filename)%(Extension)" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="InternalAPI\InternalAPI.Shipped.txt" />
    <AdditionalFiles Include="InternalAPI\InternalAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="MSTestAdapter.PlatformServices.UnitTests" Key="$(VsPublicKey)" />
    <Using Include="Polyfills" />
    <Using Include="$(RootNamespace).Resources" />
  </ItemGroup>

</Project>