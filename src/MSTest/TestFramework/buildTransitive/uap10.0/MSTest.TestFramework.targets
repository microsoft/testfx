<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\MSTest.TestFramework.targets" />

  <!--
    Classic UWP projects get the UWP extension of the framework, which provides [UITestMethod]. It ships outside lib/<tfm>
    so the package keeps a single lib layout; the hint-path reference also copies the related .pri and .xml files.
  -->
  <ItemGroup>
    <Reference Include="MSTest.Uwp">
      <HintPath>$(MSBuildThisFileDirectory)MSTest.Uwp.dll</HintPath>
      <Visible>False</Visible>
    </Reference>
  </ItemGroup>

</Project>
