<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;$(NetFrameworkMinimum);$(SupportedNetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Microsoft.VisualStudio.TestTools.UnitTesting</RootNamespace>
    <AssemblyName>MSTest.TestFramework</AssemblyName>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>

    <PackageId>MSTest.TestFramework</PackageId>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddMSTestCompatibilityFacade;_AddMSTestUIFrameworkPackageFiles</TargetsForTfmSpecificContentInPackage>
    <PackageTags>$(CommonPackageTags) MSTest TestFramework Framework</PackageTags>
    <PackageDescription><![CDATA[Write tests and shared test libraries with the MSTest framework, including UWP and WinUI UI-thread tests. Add MSTest.TestAdapter to run tests.

$(CommonProductDescription)]]></PackageDescription>
    <!-- The UWP and WinUI framework extensions ship as build-time references outside lib/<tfm> (see buildTransitive). -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <DefineConstants>$(DefineConstants);EXCLUDE_RANGE_INDEX_POLYFILL;EXCLUDE_OS_POLYFILL</DefineConstants>

    <!-- Treat "missing XML doc comment for publicly visible type or member" as a build error so
         the public API stays fully documented. See #9060. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="InternalAPI\InternalAPI.Shipped.txt" />
    <AdditionalFiles Include="InternalAPI\InternalAPI.Unshipped.txt" />

    <AdditionalFiles Include="PublicAPI\net\PublicAPI.Shipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.1'))" />
    <AdditionalFiles Include="PublicAPI\net\PublicAPI.Unshipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.1'))" />
    <AdditionalFiles Include="InternalAPI\net\InternalAPI.Shipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.1'))" />
    <AdditionalFiles Include="InternalAPI\net\InternalAPI.Unshipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netcoreapp3.1'))" />

    <AdditionalFiles Include="PublicAPI\net10.0\PublicAPI.Shipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <AdditionalFiles Include="PublicAPI\net10.0\PublicAPI.Unshipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <AdditionalFiles Include="InternalAPI\net10.0\InternalAPI.Shipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
    <AdditionalFiles Include="InternalAPI\net10.0\InternalAPI.Unshipped.txt" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />

    <AdditionalFiles Include="PublicAPI\net462\PublicAPI.Shipped.txt" Condition=" '$(TargetFramework)' == '$(NetFrameworkMinimum)' " />
    <AdditionalFiles Include="PublicAPI\net462\PublicAPI.Unshipped.txt" Condition=" '$(TargetFramework)' == '$(NetFrameworkMinimum)' " />
    <AdditionalFiles Include="InternalAPI\net462\InternalAPI.Shipped.txt" Condition=" '$(TargetFramework)' == '$(NetFrameworkMinimum)' " />
    <AdditionalFiles Include="InternalAPI\net462\InternalAPI.Unshipped.txt" Condition=" '$(TargetFramework)' == '$(NetFrameworkMinimum)' " />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\desktop\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\desktop\PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="InternalAPI\desktop\InternalAPI.Shipped.txt" />
    <AdditionalFiles Include="InternalAPI\desktop\InternalAPI.Unshipped.txt" />
    <AdditionalFiles Include="PublicAPI\deployment\PublicAPI.Shipped.txt" Condition=" '$(TargetFramework)' != 'netstandard2.0' " />
    <AdditionalFiles Include="PublicAPI\deployment\PublicAPI.Unshipped.txt" Condition=" '$(TargetFramework)' != 'netstandard2.0' " />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == '$(NetFrameworkMinimum)' ">
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == '$(NetFrameworkMinimum)' ">
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\MSTest\MSTest.Analyzers.Package\MSTest.Analyzers.Package.csproj" PrivateAssets="none" ExcludeAssets="compile;runtime" />
    <None Include="MSTest.TestFramework.targets" Pack="true" PackagePath="buildTransitive\MSTest.TestFramework.targets" />
  </ItemGroup>

  <ItemGroup Label="UWP and WinUI framework extensions" Condition=" '$(OS)' == 'Windows_NT' ">
    <None Include="buildTransitive\net10.0\MSTest.TestFramework.targets" Pack="true" PackagePath="buildTransitive\net10.0\" />
    <None Include="buildTransitive\uap10.0\MSTest.TestFramework.targets" Pack="true" PackagePath="buildTransitive\uap10.0\" Condition=" '$(UwpMinimum)' != '' " />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\MTP\Microsoft.Testing.Platform\Helpers\RoslynHashCode.cs" Link="Internal\RoslynHashCode.cs" />
    <!-- Single source of truth for CI environment detection lives in Microsoft.Testing.Platform. The
         TESTFRAMEWORK_CI_DETECTOR define selects the TestFramework variant of the class (different
         namespace, internal ctor, static Instance helper, string.IsNullOrEmpty). -->
    <Compile Include="..\..\MTP\Microsoft.Testing.Platform\Helpers\CIEnvironmentDetector.cs" Link="Internal\CIEnvironmentDetector.cs" />
  </ItemGroup>

  <Target Name="_AddMSTestCompatibilityFacade">
    <PropertyGroup>
      <_MSTestCompatibilityOutput>$(ArtifactsBinDir)TestFramework.Compatibility\$(Configuration)\$(TargetFramework)\MSTest.TestFramework.Extensions</_MSTestCompatibilityOutput>
    </PropertyGroup>
    <Error Condition=" !Exists('$(_MSTestCompatibilityOutput).dll') or !Exists('$(_MSTestCompatibilityOutput).xml') "
           Text="Build TestFramework.Compatibility for $(TargetFramework) before packing MSTest.TestFramework. Use the repository solution build and pack entry point." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_MSTestCompatibilityOutput).dll" PackagePath="lib\$(TargetFramework)\MSTest.TestFramework.Extensions.dll" />
      <TfmSpecificPackageFile Include="$(_MSTestCompatibilityOutput).xml" PackagePath="lib\$(TargetFramework)\MSTest.TestFramework.Extensions.xml" />
    </ItemGroup>
  </Target>

  <!--
    MSTest.WinUI and MSTest.Uwp both define UITestMethodAttribute, so they cannot share lib/<tfm>. They ship as
    build-time references selected by buildTransitive/<tfm>/MSTest.TestFramework.targets from UseWinUI/UseUwpTools.
    The projects reference this one, so they are built by the solution rather than through a ProjectReference.
  -->
  <Target Name="_AddMSTestUIFrameworkPackageFiles"
          Condition=" '$(OS)' == 'Windows_NT' AND '$(TargetFramework)' == 'net10.0' ">
    <PropertyGroup>
      <_MSTestWinUIOutput>$(ArtifactsBinDir)MSTest.WinUI\$(Configuration)\$(WinUiMinimum)\</_MSTestWinUIOutput>
      <_MSTestModernUwpOutput>$(ArtifactsBinDir)MSTest.Uwp\$(Configuration)\$(ModernUwpMinimum)\</_MSTestModernUwpOutput>
      <_MSTestClassicUwpOutput Condition=" '$(UwpMinimum)' != '' ">$(ArtifactsBinDir)MSTest.Uwp\$(Configuration)\$(UwpMinimum)\</_MSTestClassicUwpOutput>
    </PropertyGroup>
    <Error Condition=" !Exists('$(_MSTestWinUIOutput)MSTest.WinUI.dll') or !Exists('$(_MSTestWinUIOutput)MSTest.WinUI.pri') or !Exists('$(_MSTestWinUIOutput)MSTest.WinUI.xml') "
           Text="Build MSTest.WinUI for $(WinUiMinimum) before packing MSTest.TestFramework. Use the repository solution build and pack entry point." />
    <Error Condition=" !Exists('$(_MSTestModernUwpOutput)MSTest.Uwp.dll') or !Exists('$(_MSTestModernUwpOutput)MSTest.Uwp.xml') "
           Text="Build MSTest.Uwp for $(ModernUwpMinimum) before packing MSTest.TestFramework. Use the repository solution build and pack entry point." />
    <Error Condition=" '$(_MSTestClassicUwpOutput)' != '' AND (!Exists('$(_MSTestClassicUwpOutput)MSTest.Uwp.dll') or !Exists('$(_MSTestClassicUwpOutput)MSTest.Uwp.xml')) "
           Text="Build MSTest.Uwp for $(UwpMinimum) before packing MSTest.TestFramework. Use the repository solution build and pack entry point." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_MSTestWinUIOutput)MSTest.WinUI.dll;$(_MSTestWinUIOutput)MSTest.WinUI.pri;$(_MSTestWinUIOutput)MSTest.WinUI.xml" PackagePath="buildTransitive\net10.0\ui\winui\" />
      <!-- Localized satellites, packed under ui/winui/<culture>/ (the culture folder comes from RecursiveDir). -->
      <TfmSpecificPackageFile Include="$(_MSTestWinUIOutput)**\MSTest.WinUI.resources.dll" PackagePath="buildTransitive\net10.0\ui\winui\" />
      <TfmSpecificPackageFile Include="$(_MSTestModernUwpOutput)MSTest.Uwp.dll;$(_MSTestModernUwpOutput)MSTest.Uwp.xml" PackagePath="buildTransitive\net10.0\ui\uwp\" />
      <TfmSpecificPackageFile Include="$(_MSTestModernUwpOutput)MSTest.Uwp.pri" PackagePath="buildTransitive\net10.0\ui\uwp\" Condition="Exists('$(_MSTestModernUwpOutput)MSTest.Uwp.pri')" />
      <TfmSpecificPackageFile Include="$(_MSTestClassicUwpOutput)MSTest.Uwp.dll;$(_MSTestClassicUwpOutput)MSTest.Uwp.xml" PackagePath="buildTransitive\uap10.0\" Condition=" '$(_MSTestClassicUwpOutput)' != '' " />
      <TfmSpecificPackageFile Include="$(_MSTestClassicUwpOutput)MSTest.Uwp.pri" PackagePath="buildTransitive\uap10.0\" Condition=" '$(_MSTestClassicUwpOutput)' != '' AND Exists('$(_MSTestClassicUwpOutput)MSTest.Uwp.pri') " />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);TESTFRAMEWORK_CI_DETECTOR</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)src/Polyfills/**/*.cs" Link="Polyfills\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Enable AOT analyzer warnings to make sure we don't call APIs that would fail when we use source generator mode together with NativeAOT. -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="$(MoqPublicKey)" />
    <InternalsVisibleTo Include="MSTestAdapter.PlatformServices" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="MSTest.TestAdapter" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.TestPlatform.MSTestAdapter.UnitTests" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="MSTest.Extensions.Hosting" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="Microsoft.VisualStudio.TestPlatform.TestFramework.UnitTests" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="MSTestAdapter.PlatformServices.UnitTests" Key="$(VsPublicKey)" />
    <InternalsVisibleTo Include="MSTest.Performance.Benchmarks" Key="$(VsPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Polyfills" />
    <Using Include="$(RootNamespace).Resources" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emits the repetitive AppendLiteral/AppendFormatted overloads for the Assert.*InterpolatedStringHandler
         structs (see GenerateAssertInterpolatedStringAppendMethodsAttribute). -->
    <ProjectReference Include="..\TestFramework.SourceGeneration\TestFramework.SourceGeneration.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
