<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- If the project targets .NET Standard, it's not supposed to be a test application. So, we default to false. -->
    <IsTestApplication Condition=" '$(IsTestApplication)' == '' AND '$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETStandard' ">false</IsTestApplication>
    <IsTestApplication Condition=" '$(IsTestApplication)' == '' ">true</IsTestApplication>

    <UseVSTest Condition=" '$(UseVSTest)' == '' ">false</UseVSTest>
    <!--
      Select the package before declaring references, separately for each inner target framework.
      Desktop UWP imports can set UseUwpTools later, so UseUwp without an explicit tooling opt-out
      is also a safe early default. An explicit model owns restore-time selection without enabling
      or overriding UI tooling. Do not default the public property: an outer build's inferred model
      must not become an explicit choice in its inner builds.
    -->
    <_MSTestApplicationModel>$(MSTestApplicationModel)</_MSTestApplicationModel>
    <_MSTestApplicationModel Condition=" '$(_MSTestApplicationModel)' == '' AND '$(UseWinUI)' == 'true' ">WinUI</_MSTestApplicationModel>
    <_MSTestApplicationModel Condition=" '$(_MSTestApplicationModel)' == '' AND ('$(UseUwpTools)' == 'true' OR ('$(UseUwp)' == 'true' AND '$(UseUwpTools)' == '') OR $(TargetFramework.StartsWith('uap'))) ">Uwp</_MSTestApplicationModel>
    <_MSTestApplicationModel Condition=" '$(_MSTestApplicationModel)' == '' ">Default</_MSTestApplicationModel>
    <_MSTestUwpApplicationModel>false</_MSTestUwpApplicationModel>
    <_MSTestUwpApplicationModel Condition=" '$(_MSTestApplicationModel)' == 'Uwp' ">true</_MSTestUwpApplicationModel>
    <_MSTestWinUIApplicationModel>false</_MSTestWinUIApplicationModel>
    <_MSTestWinUIApplicationModel Condition=" '$(_MSTestApplicationModel)' == 'WinUI' ">true</_MSTestWinUIApplicationModel>
    <_MSTestAdapterPackageId>MSTest.TestAdapter</_MSTestAdapterPackageId>
    <_MSTestAdapterPackageId Condition=" '$(_MSTestApplicationModel)' == 'Uwp' ">MSTest.Uwp</_MSTestAdapterPackageId>
    <_MSTestAdapterPackageId Condition=" '$(_MSTestApplicationModel)' == 'WinUI' ">MSTest.WinUI</_MSTestAdapterPackageId>

    <_MSTestSdkHelperNeedsAdapter>false</_MSTestSdkHelperNeedsAdapter>
    <_MSTestSdkHelperNeedsAdapter
      Condition=" '$(IsTestApplication)' != 'true'
                  AND ('$(_MSTestApplicationModel)' == 'Uwp' OR '$(_MSTestApplicationModel)' == 'WinUI'
                       OR ('$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' != '.NETStandard'
                           AND ('$(EnableMSTestSourceGeneration)' == 'true'
                                OR ('$(UseVSTest)' == 'false' AND '$(PublishAot)' == 'true')))) ">true</_MSTestSdkHelperNeedsAdapter>
    <!-- A helper compiles against UI APIs/runtime hooks supplied by its eventual test application. -->
    <EnableMSTestV2CopyResources Condition=" '$(_MSTestSdkHelperNeedsAdapter)' == 'true' ">false</EnableMSTestV2CopyResources>
  </PropertyGroup>

  <!-- Import Runner.targets -->
  <Import Project="$(MSBuildThisFileDirectory)Runner/Runner.targets" Condition=" '$(UseVSTest)' == 'false' " />

  <!-- Import VSTest.targets -->
  <Import Project="$(MSBuildThisFileDirectory)VSTest/VSTest.targets" Condition=" '$(UseVSTest)' == 'true' " />

  <Target Name="_MSTestSDKValidateWindowsApplicationModel"
          BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition=" '$(IsCrossTargetingBuild)' != 'true' ">
    <Error Condition=" '$(MSTestApplicationModel)' != '' AND '$(MSTestApplicationModel)' != 'Default' AND '$(MSTestApplicationModel)' != 'Uwp' AND '$(MSTestApplicationModel)' != 'WinUI' "
           Text="Invalid value '$(MSTestApplicationModel)' for MSTestApplicationModel. Valid values are 'Default', 'Uwp' and 'WinUI'." />
    <Error Condition=" '$(UseWinUI)' == 'true' AND ('$(UseUwpTools)' == 'true' OR ('$(UseUwp)' == 'true' AND '$(UseUwpTools)' == '') OR $(TargetFramework.StartsWith('uap'))) "
           Text="A test project cannot use both WinUI and UWP application models." />
    <Error Condition=" '$(MSTestApplicationModel)' == 'Uwp' AND '$(UseWinUI)' == 'true' "
           Text="MSTestApplicationModel 'Uwp' conflicts with UseWinUI=true." />
    <Error Condition=" '$(MSTestApplicationModel)' == 'WinUI' AND ('$(UseUwpTools)' == 'true' OR ('$(UseUwp)' == 'true' AND '$(UseUwpTools)' == '') OR $(TargetFramework.StartsWith('uap'))) "
           Text="MSTestApplicationModel 'WinUI' conflicts with the UWP application model." />
    <Error Condition=" '$(MSTestApplicationModel)' == 'Default' AND ('$(UseWinUI)' == 'true' OR '$(UseUwpTools)' == 'true' OR ('$(UseUwp)' == 'true' AND '$(UseUwpTools)' == '') OR $(TargetFramework.StartsWith('uap'))) "
           Text="MSTestApplicationModel 'Default' conflicts with the configured Windows application model." />
  </Target>

  <Target Name="_MSTestSDKValidateSourceGeneration"
          BeforeTargets="PrepareForBuild"
          Condition=" '$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETStandard'
                      and ( '$(EnableMSTestSourceGeneration)' == 'true'
                            or ( '$(UseVSTest)' == 'false' and '$(PublishAot)' == 'true' ) ) ">
    <Error Text="MSTest source generation is not supported for .NET Standard target frameworks because the required MSTest.TestAdapter runtime hooks are unavailable." />
  </Target>

  <!-- Source generation is automatic for NativeAOT and opt-in for all other configurations. -->
  <ItemGroup Condition=" '$(EnableMSTestSourceGeneration)' == 'true'
                         and ( '$(UseVSTest)' == 'true' or '$(PublishAot)' != 'true' )
                         and '$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' != '.NETStandard' ">
    <PackageReference Include="MSTest.SourceGeneration" Sdk="MSTest">
      <Version Condition=" '$(ManagePackageVersionsCentrally)' != 'true' ">$(MSTestVersion)</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageVersion Include="MSTest.SourceGeneration" Version="$(MSTestVersion)"
                    Condition=" '$(ManagePackageVersionsCentrally)' == 'true' " />
  </ItemGroup>

  <ItemGroup Condition=" '$(_MSTestSdkHelperNeedsAdapter)' == 'true' ">
    <!-- Ordinary helpers need only core, except when generated code requires the adapter's runtime hooks. -->
    <PackageReference Include="$(_MSTestAdapterPackageId)" Sdk="MSTest">
      <Version Condition=" '$(ManagePackageVersionsCentrally)' != 'true' ">$(MSTestVersion)</Version>
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageVersion Include="$(_MSTestAdapterPackageId)" Version="$(MSTestVersion)"
                    Condition=" '$(ManagePackageVersionsCentrally)' == 'true' " />
  </ItemGroup>

  <!--
    Implicit bottom import.

    Only import the base .NET SDK targets when MSTest.Sdk was the SDK that imported the base .NET
    SDK props (see the detailed comment in Sdk.props). When MSTest.Sdk is layered on top of another
    base SDK, that outer SDK imports the base targets itself, so importing them here would emit
    MSB4011 duplicate-import warnings.
  -->
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition=" '$(_MSTestSdkImportsMicrosoftNETSdk)' == 'true' " />
</Project>
