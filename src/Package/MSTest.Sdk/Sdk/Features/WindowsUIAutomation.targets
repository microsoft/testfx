<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <EnableWindowsTargeting Condition=" '$(EnableWindowsTargeting)' == '' and '$(OS)' != 'Windows_NT' ">true</EnableWindowsTargeting>
    <_WindowsUIAutomationTargetPlatformIdentifier>$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))</_WindowsUIAutomationTargetPlatformIdentifier>
  </PropertyGroup>

  <Target Name="_ValidateWindowsUIAutomationPlatform" BeforeTargets="Restore;Build"
          Condition=" '$(TargetFramework)' != '' and '$(_WindowsUIAutomationTargetPlatformIdentifier)' != 'windows' ">
    <Error Text="MSTest.Windows.UIAutomation requires a Windows target framework (e.g. net8.0-windows). Current TargetFramework: '$(TargetFramework)'." />
  </Target>

  <ItemGroup>
    <PackageReference Include="MSTest.Windows.UIAutomation" Sdk="MSTest">
      <Version Condition=" '$(ManagePackageVersionsCentrally)' != 'true' ">$(MSTestWindowsUIAutomationVersion)</Version>
    </PackageReference>
    <PackageVersion Include="MSTest.Windows.UIAutomation" Version="$(MSTestWindowsUIAutomationVersion)"
                    Condition=" '$(ManagePackageVersionsCentrally)' == 'true' " />
  </ItemGroup>

  <!--
    Implicit imports
    Ensure feature is available and user hasn't opted-out from it.
    See https://github.com/dotnet/sdk/blob/f9fdf2c7d94bc86dc443e5a9ffecbd1962b1d85d/src/Tasks/Microsoft.NET.Build.Tasks/targets/Microsoft.NET.Sdk.CSharp.props#L26-L34
    -->
  <ItemGroup Condition=" '$(ImplicitUsings)' == 'true' OR '$(ImplicitUsings)' == 'enable' ">
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting.Windows.UIAutomation" />
  </ItemGroup>

</Project>
