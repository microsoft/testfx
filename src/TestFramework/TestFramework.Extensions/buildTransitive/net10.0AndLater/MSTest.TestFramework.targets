<Project>

  <PropertyGroup Condition=" '$(UseWinUI)' == 'true' ">
    <_TestFrameworkExtensionsRoot>$(MSBuildThisFileDirectory)../net10.0/winui/</_TestFrameworkExtensionsRoot>
  </PropertyGroup>

  <!--
    Desktop Visual Studio MSBuild resolves UseUwpTools before NuGet imports this target. Use the
    resolved tooling property so an explicit false continues to select the ordinary assembly.
  -->
  <PropertyGroup Condition=" '$(UseUwpTools)' == 'true' ">
    <_TestFrameworkExtensionsRoot>$(MSBuildThisFileDirectory)../net10.0/uwp/</_TestFrameworkExtensionsRoot>
  </PropertyGroup>
  
  <PropertyGroup Condition=" '$(UseWinUI)' != 'true' AND '$(UseUwpTools)' != 'true' ">
    <_TestFrameworkExtensionsRoot>$(MSBuildThisFileDirectory)</_TestFrameworkExtensionsRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MSTest.TestFramework.Extensions">
      <HintPath>$(_TestFrameworkExtensionsRoot)MSTest.TestFramework.Extensions.dll</HintPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </Reference>
  </ItemGroup>

  <!-- Replace both compiler and runtime assets, not just the assembly copied by RAR.
       Preserve NuGet metadata so dependency-file generation still recognizes the package. -->
  <Target Name="_SelectMSTestUiCore" AfterTargets="ResolvePackageAssets"
          Condition=" '$(UseWinUI)' == 'true' OR '$(UseUwpTools)' == 'true' ">
    <ItemGroup>
      <_MSTestCoreCompileAsset Include="@(ResolvedCompileFileDefinitions)" Condition=" '%(Filename)' == 'MSTest.TestFramework' " />
      <_MSTestCoreRuntimeAsset Include="@(RuntimeCopyLocalItems)" Condition=" '%(Filename)' == 'MSTest.TestFramework' " />
      <_MSTestCoreResourceAsset Include="@(ResourceCopyLocalItems)" Condition=" '%(Filename)' == 'MSTest.TestFramework.resources' " />
      <ResolvedCompileFileDefinitions Remove="@(_MSTestCoreCompileAsset)" />
      <RuntimeCopyLocalItems Remove="@(_MSTestCoreRuntimeAsset)" />
      <ResourceCopyLocalItems Remove="@(_MSTestCoreResourceAsset)" />
      <ResolvedCompileFileDefinitions Include="@(_MSTestCoreCompileAsset->'$(_TestFrameworkExtensionsRoot)MSTest.TestFramework.dll')">
        <HintPath>$(_TestFrameworkExtensionsRoot)MSTest.TestFramework.dll</HintPath>
      </ResolvedCompileFileDefinitions>
      <RuntimeCopyLocalItems Include="@(_MSTestCoreRuntimeAsset->'$(_TestFrameworkExtensionsRoot)MSTest.TestFramework.dll')" />
      <ResourceCopyLocalItems Include="@(_MSTestCoreResourceAsset->'$(_TestFrameworkExtensionsRoot)%(DestinationSubDirectory)MSTest.TestFramework.resources.dll')" />
    </ItemGroup>
  </Target>

  <!--
    Implicit imports
    Ensure feature is available and user hasn't opted-out from it.
    See https://github.com/dotnet/sdk/blob/f9fdf2c7d94bc86dc443e5a9ffecbd1962b1d85d/src/Tasks/Microsoft.NET.Build.Tasks/targets/Microsoft.NET.Sdk.CSharp.props#L26-L34
    -->
  <ItemGroup Condition="'$(ImplicitUsings)' == 'true' Or '$(ImplicitUsings)' == 'enable'">
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
