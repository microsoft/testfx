<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;$(NetFrameworkMinimum);$(SupportedNetFrameworks)</TargetFrameworks>
    <AssemblyName>MSTest.TestFramework.Extensions</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <_ApiTargetFramework>$(TargetFramework)</_ApiTargetFramework>
    <_ApiTargetFramework Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">net10.0</_ApiTargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestFramework\TestFramework.csproj" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="PublicAPI\$(_ApiTargetFramework)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\$(_ApiTargetFramework)\PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="InternalAPI\InternalAPI.Shipped.txt" />
    <AdditionalFiles Include="InternalAPI\InternalAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
