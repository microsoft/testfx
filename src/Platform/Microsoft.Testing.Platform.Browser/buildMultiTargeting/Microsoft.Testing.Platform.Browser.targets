<Project>
  <PropertyGroup>
    <TestingPlatformBrowserEnabled Condition=" '$(TestingPlatformBrowserEnabled)' == '' AND $(RuntimeIdentifier.StartsWith('browser-')) ">true</TestingPlatformBrowserEnabled>
    <_TestingPlatformBrowserAssetsDirectory>$(MSBuildThisFileDirectory)assets\</_TestingPlatformBrowserAssetsDirectory>
    <WasmMainJSPath Condition=" '$(TestingPlatformBrowserEnabled)' == 'true' AND '$(WasmMainJSPath)' == '' ">$(_TestingPlatformBrowserAssetsDirectory)Microsoft.Testing.Platform.Browser.main.js</WasmMainJSPath>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TestingPlatformBrowserEnabled)' == 'true' ">
    <WasmExtraFilesToDeploy Include="$(_TestingPlatformBrowserAssetsDirectory)index.html">
      <TargetPath>index.html</TargetPath>
    </WasmExtraFilesToDeploy>
  </ItemGroup>

  <Target Name="_ConfigureTestingPlatformBrowserRun"
          AfterTargets="ComputeRunArguments"
          Condition=" '$(TestingPlatformBrowserEnabled)' == 'true' AND $(RuntimeIdentifier.StartsWith('browser-')) ">
    <PropertyGroup>
      <_TestingPlatformBrowserLauncher>$(MSBuildThisFileDirectory)..\tools\net8.0\any\Microsoft.Testing.Platform.Browser.dll</_TestingPlatformBrowserLauncher>
      <_TestingPlatformBrowserLauncherConfiguration>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Microsoft.Testing.Platform.Browser.launch'))</_TestingPlatformBrowserLauncherConfiguration>
      <TestingPlatformBrowserHostArguments Condition=" '$(TestingPlatformBrowserHostArguments)' == '' ">run --no-build --configuration &quot;$(Configuration)&quot; --framework &quot;$(TargetFramework)&quot; --runtime &quot;$(RuntimeIdentifier)&quot; --project &quot;$(MSBuildProjectFullPath)&quot; -p:TestingPlatformBrowserEnabled=false -- --urls http://127.0.0.1:0</TestingPlatformBrowserHostArguments>

      <RunCommand Condition=" '$(DotNetHostPath)' != '' ">$(DotNetHostPath)</RunCommand>
      <RunCommand Condition=" '$(DotNetHostPath)' == '' ">dotnet</RunCommand>
      <RunArguments>exec &quot;$(_TestingPlatformBrowserLauncher)&quot; --config &quot;$(_TestingPlatformBrowserLauncherConfiguration)&quot; --</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>

    <Error Condition=" !Exists('$(_TestingPlatformBrowserLauncher)') "
           Text="Microsoft.Testing.Platform.Browser launcher was not found at '$(_TestingPlatformBrowserLauncher)'." />

    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('host-command=$(TestingPlatformBrowserHostCommand)'))"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('host-arguments=$(TestingPlatformBrowserHostArguments)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('host-working-directory=$(TestingPlatformBrowserHostWorkingDirectory)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('url-path=$(TestingPlatformBrowserUrlPath)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('browser-executable=$(TestingPlatformBrowserExecutable)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('browser-arguments=$(TestingPlatformBrowserAdditionalArguments)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('startup-timeout-seconds=$(TestingPlatformBrowserStartupTimeoutSeconds)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="$([MSBuild]::Escape('completion-timeout-seconds=$(TestingPlatformBrowserCompletionTimeoutSeconds)'))"
                      Overwrite="false"
                      Encoding="UTF-8" />

    <ItemGroup>
      <FileWrites Include="$(_TestingPlatformBrowserLauncherConfiguration)" />
    </ItemGroup>
  </Target>
</Project>
