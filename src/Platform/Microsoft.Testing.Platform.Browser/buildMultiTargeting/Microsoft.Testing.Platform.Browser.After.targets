<Project>
  <Import Project="$(_TestingPlatformBrowserPreviousCustomAfterDirectoryBuildTargets)"
          Condition=" '$(_TestingPlatformBrowserPreviousCustomAfterDirectoryBuildTargets)' != ''
                      AND '$(_TestingPlatformBrowserPreviousCustomAfterDirectoryBuildTargets)' != '$(MSBuildThisFileFullPath)'
                      AND Exists('$(_TestingPlatformBrowserPreviousCustomAfterDirectoryBuildTargets)') " />

  <Target Name="_ValidateTestingPlatformBrowserInvocation"
          AfterTargets="ComputeRunArguments"
          Condition=" '$(TestingPlatformBrowserEnabled)' == 'true'
                      AND $(RuntimeIdentifier.StartsWith('browser-'))
                      AND '$(DotnetTestInvocation)' == 'true' ">
    <PropertyGroup>
      <_TestingPlatformBrowserInvocationIdIsValid>$([System.Text.RegularExpressions.Regex]::IsMatch('$(DotnetTestInvocationId)', '^[0-9A-Fa-f]{32}$'))</_TestingPlatformBrowserInvocationIdIsValid>
    </PropertyGroup>
    <Error Condition=" '$(DotnetTestHttpBootstrapVersion)' != '1' "
           Text="Microsoft.Testing.Platform.Browser requires DotnetTestHttpBootstrapVersion=1 for a dotnet test invocation. The installed .NET SDK did not provide a supported browser HTTP bootstrap contract." />
    <Error Condition=" '$(_TestingPlatformBrowserInvocationIdIsValid)' != 'True' "
           Text="Microsoft.Testing.Platform.Browser requires DotnetTestInvocationId to be a 32-character hexadecimal GUID for a dotnet test invocation." />
  </Target>

  <Target Name="_CaptureTestingPlatformBrowserHost"
          AfterTargets="_ValidateTestingPlatformBrowserInvocation"
          Condition=" '$(TestingPlatformBrowserEnabled)' == 'true'
                      AND $(RuntimeIdentifier.StartsWith('browser-'))
                      AND '$(DotnetTestInvocation)' == 'true'
                      AND '$(DotnetTestHttpBootstrapVersion)' == '1'
                      AND '$(_TestingPlatformBrowserInvocationIdIsValid)' == 'True' ">
    <PropertyGroup>
      <_TestingPlatformBrowserComputedHostCommand>$(RunCommand)</_TestingPlatformBrowserComputedHostCommand>
      <_TestingPlatformBrowserComputedHostArguments>$(RunArguments)</_TestingPlatformBrowserComputedHostArguments>
      <_TestingPlatformBrowserComputedHostWorkingDirectory>$(RunWorkingDirectory)</_TestingPlatformBrowserComputedHostWorkingDirectory>
    </PropertyGroup>
  </Target>

  <Target Name="_ConfigureTestingPlatformBrowserRun"
          AfterTargets="_CaptureTestingPlatformBrowserHost"
          Condition=" '$(TestingPlatformBrowserEnabled)' == 'true'
                      AND $(RuntimeIdentifier.StartsWith('browser-'))
                      AND '$(DotnetTestInvocation)' == 'true'
                      AND '$(DotnetTestHttpBootstrapVersion)' == '1'
                      AND '$(_TestingPlatformBrowserInvocationIdIsValid)' == 'True' ">
    <PropertyGroup>
      <_TestingPlatformBrowserLauncher>$(MSBuildThisFileDirectory)..\tools\net8.0\any\Microsoft.Testing.Platform.Browser.dll</_TestingPlatformBrowserLauncher>
      <_TestingPlatformBrowserLauncherConfiguration>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'Microsoft.Testing.Platform.Browser.$(DotnetTestInvocationId).launch'))</_TestingPlatformBrowserLauncherConfiguration>
      <_TestingPlatformBrowserHostCommand Condition=" '$(TestingPlatformBrowserHostCommand)' != '' ">$(TestingPlatformBrowserHostCommand)</_TestingPlatformBrowserHostCommand>
      <_TestingPlatformBrowserHostCommand Condition=" '$(_TestingPlatformBrowserHostCommand)' == '' ">$(_TestingPlatformBrowserComputedHostCommand)</_TestingPlatformBrowserHostCommand>
      <_TestingPlatformBrowserHostArguments Condition=" '$(TestingPlatformBrowserHostArguments)' != '' ">$(TestingPlatformBrowserHostArguments)</_TestingPlatformBrowserHostArguments>
      <_TestingPlatformBrowserHostArguments Condition=" '$(TestingPlatformBrowserHostArguments)' == '' ">$(_TestingPlatformBrowserComputedHostArguments)</_TestingPlatformBrowserHostArguments>
      <_TestingPlatformBrowserHostWorkingDirectory Condition=" '$(TestingPlatformBrowserHostWorkingDirectory)' != '' ">$(TestingPlatformBrowserHostWorkingDirectory)</_TestingPlatformBrowserHostWorkingDirectory>
      <_TestingPlatformBrowserHostWorkingDirectory Condition=" '$(_TestingPlatformBrowserHostWorkingDirectory)' == '' ">$(_TestingPlatformBrowserComputedHostWorkingDirectory)</_TestingPlatformBrowserHostWorkingDirectory>
      <_TestingPlatformBrowserHostWorkingDirectory Condition=" '$(_TestingPlatformBrowserHostWorkingDirectory)' == '' ">$(MSBuildProjectDirectory)</_TestingPlatformBrowserHostWorkingDirectory>

      <RunCommand Condition=" '$(DOTNET_HOST_PATH)' != '' ">$(DOTNET_HOST_PATH)</RunCommand>
      <RunCommand Condition=" '$(DOTNET_HOST_PATH)' == '' ">dotnet</RunCommand>
      <RunArguments>exec &quot;$(_TestingPlatformBrowserLauncher)&quot; --config &quot;$(_TestingPlatformBrowserLauncherConfiguration)&quot; --</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>

    <Error Condition=" !Exists('$(_TestingPlatformBrowserLauncher)') "
           Text="Microsoft.Testing.Platform.Browser launcher was not found at '$(_TestingPlatformBrowserLauncher)'." />
    <Error Condition=" '$(_TestingPlatformBrowserHostCommand)' == '' "
           Text="Microsoft.Testing.Platform.Browser could not determine the browser-WASM host command from ComputeRunArguments. Set TestingPlatformBrowserHostCommand explicitly." />

    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="host-command-uri=$([System.Uri]::EscapeDataString(`$(_TestingPlatformBrowserHostCommand)`))"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="host-arguments-uri=$([System.Uri]::EscapeDataString(`$(_TestingPlatformBrowserHostArguments)`))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="host-working-directory-uri=$([System.Uri]::EscapeDataString(`$(_TestingPlatformBrowserHostWorkingDirectory)`))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="url-path-uri=$([System.Uri]::EscapeDataString(`$(TestingPlatformBrowserUrlPath)`))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="browser-executable-uri=$([System.Uri]::EscapeDataString(`$(TestingPlatformBrowserExecutable)`))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="browser-arguments-uri=$([System.Uri]::EscapeDataString(`$(TestingPlatformBrowserAdditionalArguments)`))"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="startup-timeout-seconds=$(TestingPlatformBrowserStartupTimeoutSeconds)"
                      Overwrite="false"
                      Encoding="UTF-8" />
    <WriteLinesToFile File="$(_TestingPlatformBrowserLauncherConfiguration)"
                      Lines="completion-timeout-seconds=$(TestingPlatformBrowserCompletionTimeoutSeconds)"
                      Overwrite="false"
                      Encoding="UTF-8" />
  </Target>
</Project>
