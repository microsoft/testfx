<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <RollForward>Major</RollForward>
    <PlaywrightPlatform>linux-x64;linux-arm64;osx-x64;osx-arm64;win</PlaywrightPlatform>
    <!-- Playwright's private driver payload contains nested PowerShell helper scripts. They are
         runtime data for the launcher, not NuGet install scripts. -->
    <NoWarn>$(NoWarn);NU5111</NoWarn>
    <VersionPrefix>$(MicrosoftTestingPlatformBrowserVersionPrefix)</VersionPrefix>
    <PreReleaseVersionLabel>$(MicrosoftTestingPlatformBrowserPreReleaseVersionLabel)</PreReleaseVersionLabel>
    <SuppressFinalPackageVersion>true</SuppressFinalPackageVersion>
    <PackageDescription><![CDATA[This optional package launches Microsoft Testing Platform browser-wasm test applications in an isolated headless Chromium-family browser and passes the SDK's authenticated dotnet test bootstrap directly into the browser runtime without relaying test results.

$(CommonProductDescription)]]></PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.Testing.Extensions.UnitTests" Key="$(VsPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddBrowserLauncherPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="buildMultiTargeting/**">
      <Pack>true</Pack>
      <PackagePath>buildMultiTargeting</PackagePath>
    </Content>
    <Content Include="build/**">
      <Pack>true</Pack>
      <PackagePath>build</PackagePath>
    </Content>
    <Content Include="buildTransitive/**">
      <Pack>true</Pack>
      <PackagePath>buildTransitive</PackagePath>
    </Content>
  </ItemGroup>

  <Target Name="_AddBrowserLauncherPackageFiles">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).dll"
                              PackagePath="tools\net8.0\any" />
      <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).deps.json"
                              PackagePath="tools\net8.0\any" />
      <TfmSpecificPackageFile Include="$(TargetDir)$(AssemblyName).runtimeconfig.json"
                              PackagePath="tools\net8.0\any" />
      <TfmSpecificPackageFile Include="$(TargetDir)*.dll"
                              Exclude="$(TargetDir)$(AssemblyName).dll"
                              PackagePath="tools\net8.0\any" />
      <TfmSpecificPackageFile Include="$(TargetDir).playwright\**\*"
                              PackagePath="tools\net8.0\any\.playwright\%(RecursiveDir)" />
    </ItemGroup>
  </Target>

</Project>
