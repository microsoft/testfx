<Project>

  <PropertyGroup>
    <_TestingPlatformPackagedAppPackageRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</_TestingPlatformPackagedAppPackageRoot>
    <GenerateTestingPlatformPackagedAppTestExplorerLauncher Condition="'$(GenerateTestingPlatformPackagedAppTestExplorerLauncher)' == ''">true</GenerateTestingPlatformPackagedAppTestExplorerLauncher>
  </PropertyGroup>

  <!-- Adapter targets may set IsTestingPlatformApplication after this file is imported. -->
  <Target Name="_ConfigureTestingPlatformPackagedAppEntryPoint"
          BeforeTargets="_CalculateGenerateTestingPlatformEntryPoint;_CalculateGenerateSelfRegisteredExtensions;PrepareForBuild"
          Condition="'$(IsTestingPlatformApplication)' == 'true' AND '$(IsTestApplication)' != 'false' AND '$(OutputType)' != 'Library' AND '$(UseVSTest)' != 'true' AND '$(TargetFramework)' != ''">
    <PropertyGroup Condition="$(TargetFramework.StartsWith('uap'))">
      <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
      <GenerateTestingPlatformApplicationHelper>false</GenerateTestingPlatformApplicationHelper>
      <GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
    </PropertyGroup>
    <PropertyGroup Condition="('$(UseWinUI)' == 'true' OR '$(UseUwp)' == 'true' OR '$(UseUwpTools)' == 'true') AND '@(ApplicationDefinition)' != ''">
      <GenerateTestingPlatformEntryPoint Condition="'$(GenerateTestingPlatformEntryPoint)' == ''">false</GenerateTestingPlatformEntryPoint>
      <GenerateTestingPlatformApplicationHelper Condition="'$(GenerateTestingPlatformApplicationHelper)' == '' AND !$(TargetFramework.StartsWith('uap'))">true</GenerateTestingPlatformApplicationHelper>
    </PropertyGroup>
    <ItemGroup Condition="$(TargetFramework.StartsWith('uap')) AND '$(EnableMSTestRunner)' == 'true'">
      <Compile Include="$(_TestingPlatformPackagedAppPackageRoot)buildTransitive\ClassicUwpMtpBootstrap.cs"
               Link="MicrosoftTestingPlatformApplication.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="_ConfigureTestingPlatformPackagedAppController"
          BeforeTargets="_CalculateGenerateTestingPlatformEntryPoint;PrepareForBuild;InvokeTestingPlatform"
          Condition="'$(OS)' == 'Windows_NT' AND '$(IsTestingPlatformApplication)' == 'true' AND '$(IsTestApplication)' != 'false' AND '$(OutputType)' != 'Library' AND '$(UseVSTest)' != 'true' AND '$(EnableMicrosoftTestingExtensionsPackagedApp)' != 'false' AND '$(TargetFramework)' != '' AND (('$(UseWinUI)' == 'true' AND '$(WindowsPackageType)' != 'None') OR '$(UseUwpTools)' == 'true' OR ('$(UseUwp)' == 'true' AND '$(UseUwpTools)' == '') OR $(TargetFramework.StartsWith('uap')))">
    <PropertyGroup>
      <_TestingPlatformPackagedAppControllerTfm Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">net9.0</_TestingPlatformPackagedAppControllerTfm>
      <_TestingPlatformPackagedAppControllerTfm Condition="'$(_TestingPlatformPackagedAppControllerTfm)' == ''">net8.0</_TestingPlatformPackagedAppControllerTfm>
      <_TestingPlatformPackagedAppControllerPath>$(_TestingPlatformPackagedAppPackageRoot)tools\AppModelController\$(_TestingPlatformPackagedAppControllerTfm)\mstest-appmodel-controller.exe</_TestingPlatformPackagedAppControllerPath>
      <TestingPlatformExecutablePath Condition="'$(TestingPlatformExecutablePath)' == ''">$(_TestingPlatformPackagedAppControllerPath)</TestingPlatformExecutablePath>
    </PropertyGroup>
    <Error Condition="'$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)' AND (!Exists('$(TestingPlatformExecutablePath)') OR !Exists('$(_TestingPlatformPackagedAppPackageRoot)tools\AppModelController\$(_TestingPlatformPackagedAppControllerTfm)\mstest-appmodel-controller.runtimeconfig.json') OR !Exists('$(_TestingPlatformPackagedAppPackageRoot)tools\AppModelController\$(_TestingPlatformPackagedAppControllerTfm)\Microsoft.Testing.Extensions.PackagedApp.dll'))"
           Text="The packaged-app controller payload is missing or incomplete. Restore Microsoft.Testing.Extensions.PackagedApp.MSBuild and use matching Microsoft.Testing.Platform packages." />
    <GetAssemblyIdentity AssemblyFiles="$(_TestingPlatformPackagedAppPackageRoot)tools\AppModelController\$(_TestingPlatformPackagedAppControllerTfm)\mstest-appmodel-controller.dll"
                         Condition="'$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)'">
      <Output TaskParameter="Assemblies" ItemName="_TestingPlatformPackagedAppControllerIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)' AND (!Exists('$(MicrosoftTestingPlatformMSBuildTaskFolder)Microsoft.Testing.Platform.MSBuild.dll') OR !Exists('$(MicrosoftTestingPlatformMSBuildTaskFolder)Microsoft.Testing.Platform.dll'))"
           Text="The packaged-app controller requires version-aligned Microsoft.Testing.Platform.MSBuild assets. Restore matching Microsoft.Testing.Platform packages." />
    <GetAssemblyIdentity AssemblyFiles="$(MicrosoftTestingPlatformMSBuildTaskFolder)Microsoft.Testing.Platform.MSBuild.dll;$(MicrosoftTestingPlatformMSBuildTaskFolder)Microsoft.Testing.Platform.dll"
                         Condition="'$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)'">
      <Output TaskParameter="Assemblies" ItemName="_TestingPlatformPackagedAppMSBuildIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(_TestingPlatformPackagedAppMSBuildIdentity.Version)' != '@(_TestingPlatformPackagedAppControllerIdentity->'%(Version)')'"
           Text="The packaged-app controller requires version-aligned Microsoft.Testing.Platform.MSBuild assets. Restore matching Microsoft.Testing.Platform packages." />
    <PropertyGroup Condition="'$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)'">
      <_TestingPlatformPackagedAppControllerExtensions>msbuild;packagedapp</_TestingPlatformPackagedAppControllerExtensions>
      <_TestingPlatformPackagedAppControllerExtensions Condition="'$(EnableMicrosoftTestingExtensionsCodeCoverage)' == 'true'">$(_TestingPlatformPackagedAppControllerExtensions);codecoverage</_TestingPlatformPackagedAppControllerExtensions>
      <_TestingPlatformPackagedAppControllerExtensions Condition="'$(EnableMicrosoftTestingExtensionsHangDump)' == 'true'">$(_TestingPlatformPackagedAppControllerExtensions);hangdump</_TestingPlatformPackagedAppControllerExtensions>
      <_TestingPlatformPackagedAppControllerExtensions Condition="'$(EnableMicrosoftTestingExtensionsRetry)' == 'true'">$(_TestingPlatformPackagedAppControllerExtensions);retry</_TestingPlatformPackagedAppControllerExtensions>
      <_TestingPlatformPackagedAppControllerExtensions Condition="'$(EnableMicrosoftTestingExtensionsTrxReport)' == 'true' OR $(TargetFramework.StartsWith('uap'))">$(_TestingPlatformPackagedAppControllerExtensions);trx</_TestingPlatformPackagedAppControllerExtensions>
      <_TestingPlatformPackagedAppControllerExtensions Condition="'$(EnableMSTestRunner)' == 'true'">$(_TestingPlatformPackagedAppControllerExtensions);mstest</_TestingPlatformPackagedAppControllerExtensions>
    </PropertyGroup>
  </Target>

  <!-- Resolve the built apphost only at execution time, including a clean Build;InvokeTestingPlatform call. -->
  <Target Name="_ConfigureTestingPlatformPackagedAppEnvironment"
          BeforeTargets="InvokeTestingPlatform"
          DependsOnTargets="_ConfigureTestingPlatformPackagedAppController">
    <PropertyGroup Condition="'$(_TestingPlatformPackagedAppControllerPath)' != '' AND '$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)'">
      <_TestingPlatformPackagedAppTarget>$(TargetPath)</_TestingPlatformPackagedAppTarget>
      <_TestingPlatformPackagedAppTarget Condition="'$(_IsExecutable)' == 'true' AND '$(UseAppHost)' == 'true' AND Exists('$(TargetDir)$(AssemblyName)$(_NativeExecutableExtension)')">$(TargetDir)$(AssemblyName)$(_NativeExecutableExtension)</_TestingPlatformPackagedAppTarget>
      <_TestingPlatformPackagedAppTarget Condition="$(TargetFramework.StartsWith('uap')) AND Exists('$(TargetDir)$(AssemblyName).exe')">$(TargetDir)$(AssemblyName).exe</_TestingPlatformPackagedAppTarget>
      <_TestingPlatformPackagedAppTarget Condition="'$(TestingPlatformPackagedAppTargetPath)' != ''">$(TestingPlatformPackagedAppTargetPath)</_TestingPlatformPackagedAppTarget>
      <_TestingPlatformPackagedAppTarget>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(_TestingPlatformPackagedAppTarget)'))</_TestingPlatformPackagedAppTarget>
    </PropertyGroup>
    <ItemGroup Condition="'$(_TestingPlatformPackagedAppControllerPath)' != '' AND '$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)'">
      <!-- Keep these protocol identifiers compatible with existing applications. -->
      <TestingPlatformEnvironmentVariable Remove="TESTINGPLATFORM_PACKAGEDAPP_TARGET;MSTEST_APPMODEL_CONTROLLER_EXTENSIONS" />
      <TestingPlatformEnvironmentVariable Include="TESTINGPLATFORM_PACKAGEDAPP_TARGET" Value="$(_TestingPlatformPackagedAppTarget)" />
      <TestingPlatformEnvironmentVariable Include="MSTEST_APPMODEL_CONTROLLER_EXTENSIONS" Value="$(_TestingPlatformPackagedAppControllerExtensions)" />
    </ItemGroup>
  </Target>

  <!-- The native SDK evaluates this target in a fresh project, even when builds are skipped.
       It consumes RunCommand/RunArguments, not TestingPlatformEnvironmentVariable. -->
  <Target Name="_ConfigureTestingPlatformPackagedAppRunArguments"
          AfterTargets="ComputeRunArguments"
          DependsOnTargets="_PrepareTestingPlatformPackagedAppController"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup Condition="'$(_TestingPlatformPackagedAppControllerPath)' != '' AND '$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND '$(StartAction)' != 'Program'">
      <_TestingPlatformPackagedAppDefaultRunCommand Condition="'$(UseAppHost)' == 'true'">$(TargetDir)$(AssemblyName)$(_NativeExecutableExtension)</_TestingPlatformPackagedAppDefaultRunCommand>
      <_TestingPlatformPackagedAppDefaultRunCommand Condition="'$(UseAppHost)' != 'true'">dotnet</_TestingPlatformPackagedAppDefaultRunCommand>
      <_TestingPlatformPackagedAppConfigureRun Condition="'$(RunCommand)' == '$(_TestingPlatformPackagedAppDefaultRunCommand)'">true</_TestingPlatformPackagedAppConfigureRun>
      <_TestingPlatformPackagedAppRunArguments>$(RunArguments)</_TestingPlatformPackagedAppRunArguments>
      <_TestingPlatformPackagedAppRunArguments Condition="'$(UseAppHost)' != 'true' AND $(RunArguments.StartsWith('$(_NetCoreRunArguments)'))">$(RunArguments.Substring($(_NetCoreRunArguments.Length)))</_TestingPlatformPackagedAppRunArguments>
      <_TestingPlatformPackagedAppConfigureRun Condition="'$(UseAppHost)' != 'true' AND !$(RunArguments.StartsWith('$(_NetCoreRunArguments)'))">false</_TestingPlatformPackagedAppConfigureRun>
      <_TestingPlatformPackagedAppTargetExtension>$([System.IO.Path]::GetExtension('$(_TestingPlatformPackagedAppTarget)'))</_TestingPlatformPackagedAppTargetExtension>
    </PropertyGroup>
    <Error Condition="'$(_TestingPlatformPackagedAppConfigureRun)' == 'true' AND '$(_TestingPlatformPackagedAppTargetExtension)' != '.exe'"
           Text="The packaged test host must be an executable. Enable UseAppHost or set TestingPlatformPackagedAppTargetPath to the staged packaged executable." />
    <PropertyGroup Condition="'$(_TestingPlatformPackagedAppConfigureRun)' == 'true'">
      <RunCommand>$(_TestingPlatformPackagedAppRunControllerDirectory)mstest-appmodel-controller.exe</RunCommand>
      <!-- An empty argument tail must stay empty: dotnet run only applies launch-profile arguments
           when RunArguments is empty. Keep startup metadata beside the project-local sidecar. -->
      <RunArguments>$(_TestingPlatformPackagedAppRunArguments)</RunArguments>
      <_TestingPlatformPackagedAppConfigureRun>false</_TestingPlatformPackagedAppConfigureRun>
    </PropertyGroup>
  </Target>

  <Target Name="_PrepareTestingPlatformPackagedAppController"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="_ConfigureTestingPlatformPackagedAppEnvironment"
          Condition="'$(OS)' == 'Windows_NT' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup Condition="'$(_TestingPlatformPackagedAppControllerPath)' != '' AND '$(TestingPlatformExecutablePath)' == '$(_TestingPlatformPackagedAppControllerPath)'">
      <_TestingPlatformPackagedAppRunControllerDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'PackagedAppController'))</_TestingPlatformPackagedAppRunControllerDirectory>
      <_TestingPlatformPackagedAppBootstrapFile>$(_TestingPlatformPackagedAppRunControllerDirectory)mstest-appmodel-controller.bootstrap</_TestingPlatformPackagedAppBootstrapFile>
    </PropertyGroup>
    <ItemGroup Condition="'$(_TestingPlatformPackagedAppRunControllerDirectory)' != ''">
      <_TestingPlatformPackagedAppControllerFile Include="$(_TestingPlatformPackagedAppPackageRoot)tools\AppModelController\$(_TestingPlatformPackagedAppControllerTfm)\**\*" />
      <_TestingPlatformPackagedAppBootstrapLine Include="--internal-packagedapp-controller-v1" />
      <_TestingPlatformPackagedAppBootstrapLine Include="$([MSBuild]::Escape('$(_TestingPlatformPackagedAppTarget)'))" />
      <_TestingPlatformPackagedAppBootstrapLine Include="$([MSBuild]::Escape('$(_TestingPlatformPackagedAppControllerExtensions)'))" />
      <FileWrites Include="$(_TestingPlatformPackagedAppBootstrapFile)" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestingPlatformPackagedAppControllerFile)"
          DestinationFiles="@(_TestingPlatformPackagedAppControllerFile->'$(_TestingPlatformPackagedAppRunControllerDirectory)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <WriteLinesToFile File="$(_TestingPlatformPackagedAppBootstrapFile)"
                      Lines="@(_TestingPlatformPackagedAppBootstrapLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8"
                      Condition="'$(_TestingPlatformPackagedAppRunControllerDirectory)' != ''" />
  </Target>

  <Target Name="_GetTestingPlatformPackagedAppLauncherPaths"
          Condition="'$(OS)' == 'Windows_NT' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_TestingPlatformPackagedAppLauncherTemplate>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'PackagedAppController', 'mstest-appmodel-controller.launcher.config.json'))</_TestingPlatformPackagedAppLauncherTemplate>
    </PropertyGroup>
    <ItemGroup>
      <_TestingPlatformPackagedAppLauncher Include="$([MSBuild]::Escape($([System.IO.Path]::ChangeExtension('$(TargetPath)', '.launcher.config.json'))))" />
      <_TestingPlatformPackagedAppLauncher Include="$([MSBuild]::Escape($([System.IO.Path]::ChangeExtension('$(AppxPackageRecipe)', '.launcher.config.json'))))"
                                         Condition="'$(AppxPackageRecipe)' != ''" />
    </ItemGroup>
  </Target>

  <!-- Only replace our own previous output; never overwrite a caller's launcher config. -->
  <Target Name="_DetermineTestingPlatformPackagedAppCallerLaunchers"
          DependsOnTargets="_GetTestingPlatformPackagedAppLauncherPaths"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_TestingPlatformPackagedAppExistingLauncher Include="@(_TestingPlatformPackagedAppLauncher)" Condition="Exists('%(Identity)')" />
      <_TestingPlatformPackagedAppOwnedLauncher Include="@(_TestingPlatformPackagedAppLauncher)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <GetFileHash Files="$(_TestingPlatformPackagedAppLauncherTemplate)" Condition="Exists('$(_TestingPlatformPackagedAppLauncherTemplate)')">
      <Output TaskParameter="Hash" PropertyName="_TestingPlatformPackagedAppLauncherTemplateHash" />
    </GetFileHash>
    <GetFileHash Files="@(_TestingPlatformPackagedAppExistingLauncher)" Condition="'@(_TestingPlatformPackagedAppExistingLauncher)' != ''">
      <Output TaskParameter="Items" ItemName="_TestingPlatformPackagedAppHashedLauncher" />
    </GetFileHash>
    <ItemGroup>
      <_TestingPlatformPackagedAppOwnedLauncher Include="@(_TestingPlatformPackagedAppHashedLauncher)"
                                              Condition="'%(_TestingPlatformPackagedAppHashedLauncher.FileHash)' == '$(_TestingPlatformPackagedAppLauncherTemplateHash)'" />
      <_TestingPlatformPackagedAppCallerLauncher Remove="@(_TestingPlatformPackagedAppLauncher)" />
      <_TestingPlatformPackagedAppCallerLauncher Include="@(_TestingPlatformPackagedAppExistingLauncher)" Exclude="@(_TestingPlatformPackagedAppOwnedLauncher)" />
    </ItemGroup>
  </Target>

  <!-- Test Explorer treats the appx recipe as the MTP source, but cannot execute it.
       Its launcher config must explicitly retain server mode when replacing the program. -->
  <Target Name="_GenerateTestingPlatformPackagedAppTestExplorerLauncher"
          AfterTargets="_PrepareTestingPlatformPackagedAppController"
          DependsOnTargets="_DetermineTestingPlatformPackagedAppCallerLaunchers"
          Condition="'$(_TestingPlatformPackagedAppRunControllerDirectory)' != '' AND '$(GenerateTestingPlatformPackagedAppTestExplorerLauncher)' == 'true'">
    <PropertyGroup>
      <_TestingPlatformPackagedAppLauncherProgram>$(_TestingPlatformPackagedAppRunControllerDirectory)mstest-appmodel-controller.exe</_TestingPlatformPackagedAppLauncherProgram>
      <_TestingPlatformPackagedAppLauncherJson>{ "program": "$(_TestingPlatformPackagedAppLauncherProgram.Replace('\', '\\'))", "args": [ "--server" ] }</_TestingPlatformPackagedAppLauncherJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(_TestingPlatformPackagedAppLauncherTemplate)"
                      Lines="$([MSBuild]::Escape('$(_TestingPlatformPackagedAppLauncherJson)'))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8"
                      Condition="'@(_TestingPlatformPackagedAppOwnedLauncher)' != ''" />
    <Copy SourceFiles="@(_TestingPlatformPackagedAppOwnedLauncher->'$(_TestingPlatformPackagedAppLauncherTemplate)')"
          DestinationFiles="@(_TestingPlatformPackagedAppOwnedLauncher)"
          SkipUnchangedFiles="true">
      <Output TaskParameter="DestinationFiles" ItemName="FileWrites" />
    </Copy>
    <ItemGroup>
      <FileWrites Include="$(_TestingPlatformPackagedAppLauncherTemplate)" Condition="Exists('$(_TestingPlatformPackagedAppLauncherTemplate)')" />
    </ItemGroup>
  </Target>

  <!-- Cleanup may follow a user edit without generation running. Remove relinquished
       outputs from the persisted manifest before either clean path reads them. -->
  <Target Name="_ProtectTestingPlatformPackagedAppCallerLaunchers"
          BeforeTargets="CoreClean;_CleanGetCurrentAndPriorFileWrites"
          DependsOnTargets="_DetermineTestingPlatformPackagedAppCallerLaunchers"
          Condition="'$(OS)' == 'Windows_NT' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp' AND '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_CleanPriorFileWrites Remove="@(_TestingPlatformPackagedAppCallerLauncher)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <ReadLinesFromFile File="$(IntermediateOutputPath)$(CleanFile)"
                       Condition="'@(_TestingPlatformPackagedAppCallerLauncher)' != '' AND Exists('$(IntermediateOutputPath)$(CleanFile)')">
      <Output TaskParameter="Lines" ItemName="_TestingPlatformPackagedAppCleanManifest" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_TestingPlatformPackagedAppCleanManifest Remove="@(_TestingPlatformPackagedAppCallerLauncher)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)$(CleanFile)"
                      Lines="@(_TestingPlatformPackagedAppCleanManifest)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'@(_TestingPlatformPackagedAppCallerLauncher)' != '' AND Exists('$(IntermediateOutputPath)$(CleanFile)')" />
  </Target>

  <!-- Filtering both lists avoids IncrementalClean deleting a caller edit as an orphan
       and prevents the no-build recording path from reclaiming it for a later clean. -->
  <Target Name="_ExcludeTestingPlatformPackagedAppCallerLaunchersFromClean"
          AfterTargets="_CleanGetCurrentAndPriorFileWrites"
          Condition="'@(_TestingPlatformPackagedAppCallerLauncher)' != ''">
    <ItemGroup>
      <FileWrites Remove="@(_TestingPlatformPackagedAppCallerLauncher)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <FileWritesShareable Remove="@(_TestingPlatformPackagedAppCallerLauncher)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <_CleanCurrentFileWrites Remove="@(_TestingPlatformPackagedAppCallerLauncher)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
      <_CleanPriorFileWrites Remove="@(_TestingPlatformPackagedAppCallerLauncher)" MatchOnMetadata="FullPath" MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
  </Target>

  <!-- A no-build launch query has no IncrementalClean to persist FileWrites. Record the
       staged files in MSBuild's normal clean manifest so a later clean still removes them. -->
  <Target Name="_RecordTestingPlatformPackagedAppRunControllerFiles"
          AfterTargets="_ConfigureTestingPlatformPackagedAppRunArguments"
          DependsOnTargets="_CleanRecordFileWrites"
          Condition="'$(_TestingPlatformPackagedAppBootstrapFile)' != ''" />

</Project>
