<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="RuntimeIdentifier;RuntimeIdentifiers;SelfContained;UseAppHost;EnableWindowsTargeting">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>mstest-appmodel-controller</AssemblyName>
    <RootNamespace>Microsoft.Testing.Platform.AppModelController</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- RuntimeIdentifier is a local property, so an outer RuntimeIdentifier cannot leak in. The packaging
         project selects the architecture through this private global property instead. -->
    <_PackagedAppControllerRuntimeIdentifier Condition="'$(_PackagedAppControllerRuntimeIdentifier)' == ''">win-x64</_PackagedAppControllerRuntimeIdentifier>
    <RuntimeIdentifier>$(_PackagedAppControllerRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Restore both so the apphost packs and asset targets exist for every shipped architecture. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Platform\Microsoft.Testing.Platform.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Extensions.MSBuild\Microsoft.Testing.Extensions.MSBuild.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Extensions.PackagedApp\Microsoft.Testing.Extensions.PackagedApp.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Extensions.TrxReport\Microsoft.Testing.Extensions.TrxReport.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Extensions.HangDump\Microsoft.Testing.Extensions.HangDump.csproj" />
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Extensions.Retry\Microsoft.Testing.Extensions.Retry.csproj" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

</Project>
