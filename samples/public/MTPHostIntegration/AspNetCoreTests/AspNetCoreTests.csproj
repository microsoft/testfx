<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.Web" />

  <PropertyGroup>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <TestingPlatformHostFactory>AspNetCoreTestHost.CreateHost</TestingPlatformHostFactory>
    <TestingPlatformOpenTelemetryMode>HostOwned</TestingPlatformOpenTelemetryMode>
    <MicrosoftTestingPlatformMSBuildTaskFolder>$([MSBuild]::NormalizePath($(MSBuildProjectDirectory), '..\..\..\..\artifacts\bin\Microsoft.Testing.Platform.MSBuild\$(Configuration)\netstandard2.0'))\</MicrosoftTestingPlatformMSBuildTaskFolder>
    <NoWarn>$(NoWarn);TPEXP</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="$(MSTestVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\..\src\Platform\Microsoft.Testing.Extensions.Hosting\Microsoft.Testing.Extensions.Hosting.csproj" />
    <ProjectReference Include="..\..\..\..\src\Platform\Microsoft.Testing.Extensions.OpenTelemetry\Microsoft.Testing.Extensions.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\..\..\src\Platform\Microsoft.Testing.Platform.MSBuild\Microsoft.Testing.Platform.MSBuild.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <Import Project="..\..\..\..\src\Platform\Microsoft.Testing.Extensions.Hosting\buildMultiTargeting\Microsoft.Testing.Extensions.Hosting.props" />
  <Import Project="..\..\..\..\src\Platform\Microsoft.Testing.Extensions.OpenTelemetry\buildMultiTargeting\Microsoft.Testing.Extensions.OpenTelemetry.props" />
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.Web" />
  <Import Project="..\..\..\..\src\Platform\Microsoft.Testing.Extensions.Hosting\buildMultiTargeting\Microsoft.Testing.Extensions.Hosting.targets" />
  <Import Project="..\..\..\..\src\Platform\Microsoft.Testing.Extensions.OpenTelemetry\buildMultiTargeting\Microsoft.Testing.Extensions.OpenTelemetry.targets" />
  <Import Project="..\..\..\..\src\Platform\Microsoft.Testing.Platform.MSBuild\buildMultiTargeting\Microsoft.Testing.Platform.MSBuild.targets" />

</Project>
