<Project>

  <PropertyGroup>
    <AspireTestingVersion>13.4.6</AspireTestingVersion>
    <CodeCoverageVersion>18.11.0</CodeCoverageVersion>
    <MSTestVersion>4.4.1</MSTestVersion>
    <!--
      MSTestAOTVersion pins the compatible experimental MSTest.Engine and MSTest.SourceGeneration
      pair used by the non-SDK Native AOT runner sample (mstest-runner/NativeAotRunner).
      MSTestSdkAOTVersion pins the newer source generator required by MSTest.Sdk's Native AOT
      pipeline. Both remain independently pinned to versions mirrored to the dotnet-public NuGet
      feed used by these samples. The SDK-specific pin can be removed once a matching stable
      MSTest.SourceGeneration package is available on the feed.
    -->
    <MSTestAOTVersion>2.0.0-alpha.26228.3</MSTestAOTVersion>
    <MSTestEngineVersion>$(MSTestAOTVersion)</MSTestEngineVersion>
    <MSTestPreviewVersion>4.5.0-preview.26479.5</MSTestPreviewVersion>
    <MSTestExtensionsHostingVersion>$(MSTestPreviewVersion)</MSTestExtensionsHostingVersion>
    <MSTestSdkPreviewVersion>4.5.0-preview.26480.2</MSTestSdkPreviewVersion>
    <MSTestSdkAOTVersion>$(MSTestSdkPreviewVersion)</MSTestSdkAOTVersion>
    <PlaywrightVersion>1.61.0</PlaywrightVersion>
    <TestingPlatformVersion>2.4.1</TestingPlatformVersion>
    <!-- Hosted entry point generation is currently available only in preview packages. -->
    <TestingPlatformPreviewVersion>2.5.0-preview.26479.5</TestingPlatformPreviewVersion>
    <MicrosoftTestingExtensionsHostingVersion>1.0.0-alpha.26479.5</MicrosoftTestingExtensionsHostingVersion>
    <!--
      Microsoft.Testing.Extensions.PackagedApp deploys and launches a packaged Windows (UWP/WinUI)
      test host. Keep it aligned with the testing platform version required by the MSTest.Sdk preview.
    -->
    <MicrosoftTestingExtensionsPackagedAppVersion>2.5.0-preview.26480.2</MicrosoftTestingExtensionsPackagedAppVersion>
    <VSTestVersion>18.9.0</VSTestVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA0001;EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

</Project>
