<Project>

  <PropertyGroup>
    <AspireTestingVersion>13.6.5</AspireTestingVersion>
    <AspireHostingTestingVersion>$(AspireTestingVersion)</AspireHostingTestingVersion>
    <CodeCoverageVersion>18.12.0</CodeCoverageVersion>
    <MSTestVersion>4.5.3</MSTestVersion>
    <MSTestPreviewVersion>4.5.3-preview.26560.5</MSTestPreviewVersion>
    <MSTestWindowsUIAutomationVersion Condition="'$(MSTestWindowsUIAutomationVersion)' == ''">$(MSTestPreviewVersion)</MSTestWindowsUIAutomationVersion>
    <!-- Hosting extensions are independently prerelease; update their pins separately
         when selecting a new MSTest or MTP sample release. -->
    <MSTestExtensionsHostingVersion Condition="'$(MSTestExtensionsHostingVersion)' == ''">4.5.2-alpha.26527.6</MSTestExtensionsHostingVersion>
    <MTPVersion>2.5.3</MTPVersion>
    <!-- These extensions are still prerelease; stable MSTest/MTP versions are not published for them. -->
    <MTPPreviewVersion>2.5.3-preview.26560.5</MTPPreviewVersion>
    <!-- PackagedApp.MSBuild pins its platform exactly; use a build newer than the stable adapter's minimum. -->
    <MicrosoftTestingExtensionsPackagedAppVersion Condition="'$(MicrosoftTestingExtensionsPackagedAppVersion)' == ''">2.5.4-preview.26561.13</MicrosoftTestingExtensionsPackagedAppVersion>
    <MicrosoftTestingExtensionsAzureDevOpsReportVersion Condition="'$(MicrosoftTestingExtensionsAzureDevOpsReportVersion)' == ''">$(MTPPreviewVersion)</MicrosoftTestingExtensionsAzureDevOpsReportVersion>
    <MicrosoftTestingExtensionsGitHubActionsReportVersion Condition="'$(MicrosoftTestingExtensionsGitHubActionsReportVersion)' == ''">$(MTPPreviewVersion)</MicrosoftTestingExtensionsGitHubActionsReportVersion>
    <MicrosoftTestingExtensionsHtmlReportVersion Condition="'$(MicrosoftTestingExtensionsHtmlReportVersion)' == ''">$(MTPPreviewVersion)</MicrosoftTestingExtensionsHtmlReportVersion>
    <MicrosoftTestingExtensionsOpenTelemetryVersion Condition="'$(MicrosoftTestingExtensionsOpenTelemetryVersion)' == ''">$(MTPPreviewVersion)</MicrosoftTestingExtensionsOpenTelemetryVersion>
    <MicrosoftTestingExtensionsCtrfReportVersion Condition="'$(MicrosoftTestingExtensionsCtrfReportVersion)' == ''">1.0.0-alpha.26560.5</MicrosoftTestingExtensionsCtrfReportVersion>
    <MicrosoftTestingExtensionsJUnitReportVersion Condition="'$(MicrosoftTestingExtensionsJUnitReportVersion)' == ''">1.0.0-alpha.26560.5</MicrosoftTestingExtensionsJUnitReportVersion>
    <MicrosoftTestingExtensionsHostingVersion Condition="'$(MicrosoftTestingExtensionsHostingVersion)' == ''">1.0.0-alpha.26527.6</MicrosoftTestingExtensionsHostingVersion>
    <PlaywrightVersion>1.61.0</PlaywrightVersion>
    <VSTestVersion>18.10.2</VSTestVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA0001;EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

</Project>
