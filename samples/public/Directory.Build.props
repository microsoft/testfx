<Project>

  <PropertyGroup>
    <AspireTestingVersion>13.4.6</AspireTestingVersion>
    <CodeCoverageVersion>18.12.0</CodeCoverageVersion>
    <MSTestVersion>4.5.2</MSTestVersion>
    <!-- Hosting extensions are independently prerelease; update their pins separately
         when selecting a new MSTest or MTP sample release. -->
    <MSTestExtensionsHostingVersion Condition="'$(MSTestExtensionsHostingVersion)' == ''">4.5.2-alpha.26527.6</MSTestExtensionsHostingVersion>
    <MTPVersion>2.5.2</MTPVersion>
    <MicrosoftTestingExtensionsHostingVersion Condition="'$(MicrosoftTestingExtensionsHostingVersion)' == ''">1.0.0-alpha.26527.6</MicrosoftTestingExtensionsHostingVersion>
    <PlaywrightVersion>1.61.0</PlaywrightVersion>
    <VSTestVersion>18.10.1</VSTestVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);SA0001;EnableGenerateDocumentationFile</NoWarn>
  </PropertyGroup>

</Project>
