testfx_matrix(
    name = "managed_all",
    target = ":managed",
)

# Short executable labels avoid Windows' doubled runfiles batch-file paths.
# The other explorer cases intentionally demonstrate failures and skips.
csharp_binary(
    name = "explorer_released",
    srcs = ["//samples/public/TestingPlatformExamples/TestingPlatformExplorer:sources"],
    out = "TestingPlatformExplorer",
    appsetting_files = ["//samples/public/TestingPlatformExamples/TestingPlatformExplorer:TestingPlatformExplorer.testingplatformconfig.json"],
    generate_documentation_file = False,
    langversion = "preview",
    nullable = "enable",
    target_frameworks = ["net10.0"],
    deps = [
        "@paket.main//microsoft.testing.extensions.trxreport",
        "@paket.main//microsoft.testing.extensions.trxreport.abstractions",
        "@paket.main//microsoft.testing.platform",
    ],
)

csharp_binary(
    name = "explorer",
    srcs = ["//samples/public/TestingPlatformExamples/TestingPlatformExplorer:sources"],
    out = "TestingPlatformExplorer",
    appsetting_files = ["//samples/public/TestingPlatformExamples/TestingPlatformExplorer:TestingPlatformExplorer.testingplatformconfig.json"],
    generate_documentation_file = False,
    langversion = "preview",
    nullable = "enable",
    target_frameworks = ["net10.0"],
    deps = [
        ":platform",
        ":trx",
        ":trx_abstractions",
    ],
)

testfx_test(
    name = "explorer_test",
    size = "small",
    args = [
        "--filter-uid",
        "TestingPlatformExplorer.UnitTests.SomeTests.TestMethod1",
    ],
    binary = ":explorer",
)

testfx_test(
    name = "explorer_released_test",
    size = "small",
    args = [
        "--filter-uid",
        "TestingPlatformExplorer.UnitTests.SomeTests.TestMethod1",
    ],
    binary = ":explorer_released",
)

testfx_binary(
    name = "simple1",
    defines = ["TESTFX_REPORTS"],
    generate_documentation_file = False,
    linked_srcs = ["//eng/bazel:TestMain.cs"],
    polyfills = False,
    project = "samples/public/mstest-runner/Simple1",
    deps = [
        ":adapter",
        ":ctrf",
        ":framework",
        ":framework_extensions",
        ":html",
        ":junit",
        ":trx",
    ],
)

testfx_test(
    name = "simple1_test",
    size = "small",
    args = [
        "--minimum-expected-tests",
        "1",
    ],
    binary = ":simple1",
)

testfx_binary(
    name = "framework_tests_app",
    assembly_name = "Microsoft.VisualStudio.TestPlatform.TestFramework.UnitTests",
    defines = ["TESTFX_INTERNAL_TESTS"],
    exclude = ["test/UnitTests/TestFramework.UnitTests/Program.cs"],
    generate_documentation_file = False,
    linked_srcs = ["//eng/bazel:TestMain.cs"],
    project = "test/UnitTests/TestFramework.UnitTests",
    deps = [
        ":framework",
        ":framework_extensions",
        ":internal_test_framework",
        ":trx",
        "@paket.source//awesomeassertions",
        "@paket.source//moq",
    ],
)

testfx_test(
    name = "framework_tests",
    size = "medium",
    args = [
        "--minimum-expected-tests",
        "1",
    ],
    binary = ":framework_tests_app",
)

testfx_test(
    name = "explorer_failure_probe",
    size = "small",
    args = [
        "--filter-uid",
        "TestingPlatformExplorer.UnitTests.SomeTests.TestMethod2",
    ],
    binary = ":explorer",
    tags = ["manual"],
)

test_suite(
    name = "baseline_tests",
    tests = [
        ":adapter_tests",
        ":build_tools_tests",
        ":explorer_released_test",
        ":explorer_test",
        ":framework_tests",
        ":platform_services_tests",
        ":simple1_test",
    ],
)

test_suite(
    name = "portable_tests",
    tests = [
        ":baseline_tests",
        ":protocol_contract_tests",
        ":source_generation_tests",
        ":vstest_bridge_tests",
    ],
)
