<Project>
  <PropertyGroup Label="Version settings">
    <!-- MSTest version -->
    <VersionPrefix>5.0.0</VersionPrefix>
    <!-- Testing Platform version -->
    <TestingPlatformVersionPrefix>3.0.0</TestingPlatformVersionPrefix>
    <PreReleaseVersionLabel>preview</PreReleaseVersionLabel>
  </PropertyGroup>
  <PropertyGroup Label="MSTest prod dependencies - darc updated">
    <MicrosoftDotNetBuildTasksTemplatingPackageVersion>12.0.0-beta.26569.6</MicrosoftDotNetBuildTasksTemplatingPackageVersion>
    <MicrosoftTestingExtensionsCodeCoverageVersion>18.14.0-preview.26570.4</MicrosoftTestingExtensionsCodeCoverageVersion>
    <MicrosoftTestingExtensionsAffectedTestsVersion>18.14.0-preview.26573.4</MicrosoftTestingExtensionsAffectedTestsVersion>
    <!-- empty line to avoid merge conflicts for darc PRs to update CC and MSTest+MTP -->
    <MSTestVersion>5.0.0-preview.26573.9</MSTestVersion>
    <MicrosoftTestingPlatformVersion>3.0.0-preview.26573.9</MicrosoftTestingPlatformVersion>
  </PropertyGroup>
</Project>
