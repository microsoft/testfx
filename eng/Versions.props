<Project>
  <PropertyGroup Label="Version settings">
    <!-- MSTest version -->
    <VersionPrefix>4.5.0</VersionPrefix>
    <!-- Testing Platform version -->
    <TestingPlatformVersionPrefix>2.5.0</TestingPlatformVersionPrefix>
    <PreReleaseVersionLabel>preview</PreReleaseVersionLabel>
  </PropertyGroup>
  <PropertyGroup Label="MSTest prod dependencies - darc updated">
    <MicrosoftDotNetBuildTasksTemplatingPackageVersion>12.0.0-beta.26467.7</MicrosoftDotNetBuildTasksTemplatingPackageVersion>
    <MicrosoftTestingExtensionsCodeCoverageVersion>18.12.0-preview.26466.2</MicrosoftTestingExtensionsCodeCoverageVersion>
    <!-- empty line to avoid merge conflicts for darc PRs to update CC and MSTest+MTP -->
    <MSTestVersion>4.5.0-preview.26467.6</MSTestVersion>
    <MicrosoftTestingPlatformVersion>2.5.0-preview.26467.6</MicrosoftTestingPlatformVersion>
  </PropertyGroup>
</Project>
