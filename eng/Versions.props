<Project>
  <PropertyGroup Label="Version settings">
    <!-- MSTest version -->
    <VersionPrefix>4.6.0</VersionPrefix>
    <!-- Testing Platform version -->
    <TestingPlatformVersionPrefix>2.6.0</TestingPlatformVersionPrefix>
    <PreReleaseVersionLabel>preview</PreReleaseVersionLabel>
  </PropertyGroup>
  <PropertyGroup Label="MSTest prod dependencies - darc updated">
    <MicrosoftDotNetBuildTasksTemplatingPackageVersion>12.0.0-beta.26509.4</MicrosoftDotNetBuildTasksTemplatingPackageVersion>
    <MicrosoftTestingExtensionsCodeCoverageVersion>18.13.0-preview.26513.2</MicrosoftTestingExtensionsCodeCoverageVersion>
    <MicrosoftTestingExtensionsAffectedTestsVersion>18.13.0-preview.26513.2</MicrosoftTestingExtensionsAffectedTestsVersion>
    <!-- empty line to avoid merge conflicts for darc PRs to update CC and MSTest+MTP -->
    <MSTestVersion>4.6.0-preview.26513.6</MSTestVersion>
    <MicrosoftTestingPlatformVersion>2.6.0-preview.26513.6</MicrosoftTestingPlatformVersion>
  </PropertyGroup>
</Project>
