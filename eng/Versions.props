<Project>
  <PropertyGroup Label="Version settings">
    <!-- MSTest version -->
    <VersionPrefix>5.0.0</VersionPrefix>
    <!-- Testing Platform version -->
    <TestingPlatformVersionPrefix>3.0.0</TestingPlatformVersionPrefix>
    <PreReleaseVersionLabel>preview</PreReleaseVersionLabel>
  </PropertyGroup>
  <PropertyGroup Label="MSTest prod dependencies - darc updated">
    <MicrosoftDotNetBuildTasksTemplatingPackageVersion>12.0.0-beta.26561.3</MicrosoftDotNetBuildTasksTemplatingPackageVersion>
    <MicrosoftTestingExtensionsCodeCoverageVersion>18.13.0-preview.26560.2</MicrosoftTestingExtensionsCodeCoverageVersion>
    <MicrosoftTestingExtensionsAffectedTestsVersion>18.13.0-preview.26560.3</MicrosoftTestingExtensionsAffectedTestsVersion>
    <!-- empty line to avoid merge conflicts for darc PRs to update CC and MSTest+MTP -->
    <MSTestVersion>5.0.0-preview.26560.14</MSTestVersion>
    <MicrosoftTestingPlatformVersion>3.0.0-preview.26560.14</MicrosoftTestingPlatformVersion>
  </PropertyGroup>
</Project>
