diff --git a/dotnet/private/common.bzl b/dotnet/private/common.bzl
index c8a8cbd..b286991 100644
--- a/dotnet/private/common.bzl
+++ b/dotnet/private/common.bzl
@@ -229,17 +229,49 @@ def _format_ref_with_overrides(assembly):
         return None
     return "-r:" + assembly.path
 
-def format_ref_arg(args, refs):
+def format_ref_arg(args, refs, reference_aliases = {}):
     """Takes
 
     Args:
         args: The args object that will be sent into the compilation action
         refs: List of all references that are being sent into the compilation action
+        reference_aliases: C# aliases by assembly simple name. Include "global"
+            explicitly when the reference must also be globally accessible.
     Returns:
         The updated args object
     """
 
-    args.add_all(refs, map_each = _format_ref_with_overrides)
+    if not reference_aliases:
+        args.add_all(refs, map_each = _format_ref_with_overrides)
+        return args
+
+    aliases_by_name = {}
+    for name, aliases in reference_aliases.items():
+        normalized = name.lower()
+        if not name or normalized in aliases_by_name:
+            fail("Reference alias assembly names must be nonempty and unique: " + name)
+        if not aliases or len({alias: True for alias in aliases}) != len(aliases):
+            fail("Reference aliases must be nonempty and unique for " + name)
+        for alias in aliases:
+            if not alias or any([character in alias for character in [" ", "\t", "\r", "\n", ",", "=", "\"", "%"]]):
+                fail("Invalid reference alias for {}: {}".format(name, repr(alias)))
+        aliases_by_name[normalized] = aliases
+
+    unmatched = dict(aliases_by_name)
+    ordinary = []
+    for assembly in refs.to_list():
+        if _format_ref_with_overrides(assembly) == None:
+            continue
+        name = assembly.basename.rsplit(".", 1)[0].lower()
+        if name in aliases_by_name:
+            for alias in aliases_by_name[name]:
+                args.add(assembly, format = "-r:" + alias + "=%s")
+            unmatched.pop(name, None)
+        else:
+            ordinary.append(assembly)
+    if unmatched:
+        fail("Reference aliases name assemblies absent from this compilation: " + ", ".join(sorted(unmatched.keys())))
+    args.add_all(ordinary, map_each = _format_ref_with_overrides)
 
     return args
 
