diff --git a/dotnet/private/sdk/frameworks.bzl b/dotnet/private/sdk/frameworks.bzl
index 76dd92c..287c2fd 100644
--- a/dotnet/private/sdk/frameworks.bzl
+++ b/dotnet/private/sdk/frameworks.bzl
@@ -133,8 +133,48 @@ def _compatibility(families):
 # Each framework mapped to the frameworks it can directly compile against.
 # The relationship is transitive. Order matters: netstandard first, and
 # within a family oldest to newest.
-FRAMEWORK_COMPATIBILITY = _compatibility([
+_BASE_COMPATIBILITY = _compatibility([
     SDK_NETSTANDARD_FRAMEWORKS,
     SDK_NETFRAMEWORK_FRAMEWORKS,
     SDK_NETCOREAPP_FRAMEWORKS,
 ])
+
+# CsWinRT 2.x Windows platforms. The .1 platforms require the separate
+# CsWinRT 3.x generator pipeline and are deliberately not aliases for .0.
+WINDOWS_PLATFORM_VERSIONS = [
+    "7.0",
+    "8.0",
+    "10.0.17763.0",
+    "10.0.18362.0",
+    "10.0.19041.0",
+    "10.0.20348.0",
+    "10.0.22000.0",
+    "10.0.22621.0",
+    "10.0.26100.0",
+]
+
+def _with_windows_platforms(base):
+    result = {}
+    previous_net = None
+    for tfm, compatible in base.items():
+        result[tfm] = compatible
+        if tfm not in SDK_NETCOREAPP_FRAMEWORKS or tfm.startswith("netcoreapp"):
+            continue
+        # Bound this experiment to the library matrix and older package assets.
+        if _dotted_version(tfm, "net")[0] > 11:
+            continue
+        previous_platform = None
+        for version in WINDOWS_PLATFORM_VERSIONS:
+            windows_tfm = tfm + "-windows" + version
+            edges = [tfm]
+            if previous_net:
+                edges.append(previous_net + "-windows" + version)
+            if previous_platform:
+                edges.append(previous_platform)
+            result[windows_tfm] = edges
+            previous_platform = windows_tfm
+        previous_net = tfm
+    return result
+
+FRAMEWORK_COMPATIBILITY = _with_windows_platforms(_BASE_COMPATIBILITY)
+WINDOWS_FRAMEWORKS = [tfm for tfm in FRAMEWORK_COMPATIBILITY if "-windows" in tfm]
