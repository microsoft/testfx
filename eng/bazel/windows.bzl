"""Native Windows library inputs; no XAML compiler or MSBuild invocation."""

load("@rules_dotnet//dotnet:defs.bzl", "csharp_binary", "import_library", "publish_binary")
load(":defs.bzl", "PORTABLE_FRAMEWORKS", "testfx_library", "testfx_matrix")

_PLATFORM = "src/Platform/Microsoft.Testing.Platform"
_SHARED = "src/Platform/SharedExtensionHelpers"
_PACKAGED_APP = "src/Platform/Microsoft.Testing.Extensions.PackagedApp"
_FRAMEWORK = "src/TestFramework/TestFramework"
_UI_AUTOMATION = "src/TestFramework/TestFramework.Windows.UIAutomation"
_PACKAGED_FRAMEWORKS = [tfm + "-windows10.0.19041.0" for tfm in PORTABLE_FRAMEWORKS]
_DESKTOP_FRAMEWORKS = [tfm + "-windows7.0" for tfm in PORTABLE_FRAMEWORKS]
_CODE_COVERAGE_VERSION = "18.13.0-preview.26527.4"

def _package_files_impl(ctx):
    selected = []
    files = ctx.files.package
    for suffix in ctx.attr.suffixes:
        matches = [file for file in files if file.path.endswith("/" + suffix)]
        if len(matches) != 1:
            fail("Expected exactly one '{}' in {}, found {}".format(suffix, ctx.attr.package.label, matches))
        selected.extend(matches)
    return [DefaultInfo(files = depset(selected))]

_package_files = rule(
    implementation = _package_files_impl,
    attrs = {
        "package": attr.label(mandatory = True),
        "suffixes": attr.string_list(mandatory = True),
    },
)

def _projection(name, group, version, framework):
    package = "@windows." + group + "//microsoft.windows.sdk.net.ref:files"
    _package_files(
        name = name + "_dlls",
        package = package,
        suffixes = [
            "lib/" + framework + "/Microsoft.Windows.SDK.NET.dll",
            "lib/" + framework + "/WinRT.Runtime.dll",
        ],
    )
    _package_files(
        name = name + "_analyzer",
        package = package,
        suffixes = ["analyzers/dotnet/cs/WinRT.SourceGenerator.dll"],
    )
    _package_files(
        name = name + "_nupkg",
        package = package,
        suffixes = ["microsoft.windows.sdk.net.ref." + version + ".nupkg"],
    )
    import_library(
        name = name,
        library_name = "Microsoft.Windows.SDK.NET.Ref",
        version = version,
        refs = [":" + name + "_dlls"],
        libs = [":" + name + "_dlls"],
        analyzers_csharp = [":" + name + "_analyzer"],
        nupkg = ":" + name + "_nupkg",
    )

def _windows_metadata_impl(ctx):
    output = ctx.actions.declare_file(ctx.label.name + ".g.cs")
    lines = ["﻿// <auto-generated/>"]
    for framework in ctx.attr.frameworks:
        net, platform = framework.split("-windows")
        lines.extend([
            "#if " + net.upper().replace(".", "_"),
            '[assembly: System.Runtime.Versioning.TargetFramework(".NETCoreApp,Version=v%s")]' % net[3:],
            '[assembly: System.Runtime.Versioning.TargetPlatform("Windows%s")]' % platform,
        ])
        if ctx.attr.emit_supported_os:
            lines.append('[assembly: System.Runtime.Versioning.SupportedOSPlatform("windows%s")]' % (ctx.attr.minimum_version or platform))
        lines.append("#endif")
    ctx.actions.write(output, "\n".join(lines) + "\n")
    return [DefaultInfo(files = depset([output]))]

_windows_metadata = rule(
    implementation = _windows_metadata_impl,
    attrs = {
        "frameworks": attr.string_list(mandatory = True),
        "minimum_version": attr.string(),
        "emit_supported_os": attr.bool(default = True),
    },
)

def _windows_library(name, target_frameworks, linked_srcs = [], minimum_version = "", emit_supported_os = True, **kwargs):
    _windows_metadata(
        name = name + "_windows_metadata",
        frameworks = target_frameworks,
        minimum_version = minimum_version,
        emit_supported_os = emit_supported_os,
    )
    testfx_library(
        name = name,
        target_frameworks = target_frameworks,
        linked_srcs = linked_srcs + [":" + name + "_windows_metadata"],
        **kwargs
    )

def _mstest_flavor(flavor, framework, symbol, projection_deps):
    core = "framework_" + flavor
    extensions = "framework_extensions_" + flavor
    services = "platform_services_" + flavor
    adapter = "adapter_" + flavor
    framework_project = "src/TestFramework/TestFramework.Extensions"
    services_project = "src/Adapter/MSTestAdapter.PlatformServices"
    adapter_project = "src/Adapter/MSTest.TestAdapter"
    _windows_library(
        name = core,
        project = _FRAMEWORK,
        assembly_name = "MSTest.TestFramework",
        target_frameworks = [framework],
        minimum_version = "10.0.17763.0" if flavor == "winui" else "",
        defines = ["EXCLUDE_RANGE_INDEX_POLYFILL", "EXCLUDE_OS_POLYFILL", "TESTFRAMEWORK_CI_DETECTOR", symbol],
        linked_srcs = [
            _PLATFORM + "/Helpers/RoslynHashCode.cs",
            _PLATFORM + "/Helpers/CIEnvironmentDetector.cs",
        ],
        resources = {_FRAMEWORK + "/Resources/FrameworkMessages.resx": "Microsoft.VisualStudio.TestTools.UnitTesting.Resources.FrameworkMessages"},
        usings = ["Polyfills", "Microsoft.VisualStudio.TestTools.UnitTesting.Resources"],
        internals_visible_to = [
            "DynamicProxyGenAssembly2",
            "MSTestAdapter.PlatformServices",
            "MSTest.TestAdapter",
            "Microsoft.VisualStudio.TestPlatform.MSTestAdapter.UnitTests",
            "MSTest.TestFramework.Extensions",
            "MSTest.Extensions.Hosting",
            "Microsoft.VisualStudio.TestPlatform.TestFramework.UnitTests",
            "MSTestAdapter.PlatformServices.UnitTests",
            "MSTest.Performance.Benchmarks",
        ],
        deps = [":assert_generator_plugin"],
    )
    _windows_library(
        name = extensions,
        project = framework_project,
        assembly_name = "MSTest.TestFramework.Extensions",
        target_frameworks = [framework],
        # The WinUI source already carries its supported-OS annotation.
        emit_supported_os = flavor != "winui",
        defines = ["EXCLUDE_RANGE_INDEX_POLYFILL", "EXCLUDE_OS_POLYFILL", symbol],
        usings = ["Polyfills", "Microsoft.VisualStudio.TestTools.UnitTesting.Resources"],
        resources = {framework_project + "/Resources/FrameworkExtensionsMessages.resx": "Microsoft.VisualStudio.TestTools.UnitTesting.Resources.FrameworkExtensionsMessages"},
        analyzer_configs = ["//eng/bazel/windows:winrt.globalconfig"],
        embedded_resources = {
            framework_project + "/Properties/Extension.UWP.rd.xml": "Microsoft.VisualStudio.TestTools.UnitTesting.Properties.Extension.UWP.rd.xml",
        } if flavor == "uwp" else {},
        internals_visible_to = [
            "MSTestAdapter.PlatformServices",
            "MSTestAdapter.PlatformServices.UnitTests",
            "MSTest.TestAdapter",
            "Microsoft.VisualStudio.TestPlatform.MSTestAdapter.UnitTests",
        ],
        deps = [":" + core] + projection_deps,
    )
    _windows_library(
        name = services,
        project = services_project,
        target_frameworks = [framework],
        emit_supported_os = flavor != "winui",
        allow_unsafe_blocks = True,
        defines = ["EXCLUDE_OS_POLYFILL", symbol],
        usings = ["Polyfills", "Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.Resources"],
        linked_srcs = native.glob(["src/Platform/Microsoft.Testing.Extensions.TrxReport/Hashing/**/*.cs"]),
        resources = {services_project + "/Resources/Resource.resx": "Microsoft.VisualStudio.TestPlatform.MSTestAdapter.PlatformServices.Resources.Resource"},
        analyzer_configs = ["//eng/bazel/windows:winrt.globalconfig"],
        internals_visible_to = [
            "DynamicProxyGenAssembly2",
            "MSTest.TestAdapter",
            "Microsoft.VisualStudio.TestPlatform.MSTestAdapter.UnitTests",
            "MSTestAdapter.PlatformServices.UnitTests",
            "MSTest.Acceptance.IntegrationTests",
            "MSTest.Performance.Benchmarks",
        ],
        deps = [":" + core, ":" + extensions] + projection_deps,
    )
    _windows_library(
        name = adapter,
        project = adapter_project,
        target_frameworks = [framework],
        defines = ["MSTEST_TESTADAPTER", symbol],
        usings = ["Polyfills", "ExecutionScope=Microsoft.VisualStudio.TestTools.UnitTesting.ExecutionScope"],
        linked_srcs = [
            "src/Adapter/Shared/BannerMessageHelper.cs",
            _SHARED + "/RunSettingsProviderHelper.cs",
            _SHARED + "/RunSettingsCommandLineOptionsProviderBase.cs",
            _SHARED + "/RunSettingsConfigurationProviderBase.cs",
            _SHARED + "/RunSettingsEnvironmentVariableProviderBase.cs",
            _SHARED + "/TestRunParametersCommandLineOptionsProviderBase.cs",
            _SHARED + "/TestCaseFilterCommandLineOptionsProviderBase.cs",
            "@paket.source//microsoft.testplatform.filter.source:content_files",
        ] + ([_PACKAGED_APP + "/CommandLineOptionParser.cs"] if flavor == "uwp" else []),
        resources = {adapter_project + "/Resources/PlatformAdapterResources.resx": "Microsoft.VisualStudio.TestPlatform.MSTest.TestAdapter.Resources.PlatformAdapterResources"},
        build_info = adapter_project + "/BuildInfo.cs.template",
        internals_visible_to = [
            "MSTest.Extensions.Hosting",
            "DynamicProxyGenAssembly2",
            "Microsoft.VisualStudio.TestPlatform.MSTestAdapter.UnitTests",
            "MSTestAdapter.PlatformServices.UnitTests",
            "MSTest.Acceptance.IntegrationTests",
            "MSTest.Performance.Benchmarks",
            "MSTest.Analyzers.UnitTests",
        ],
        deps = [
            ":platform",
            ":" + services,
            ":" + core,
            ":" + extensions,
            ":trx_abstractions",
            ":trx",
