    native.filegroup(name = "_windows_" + flavor, srcs = [":" + core, ":" + extensions, ":" + services, ":" + adapter])
    testfx_matrix(name = "windows_" + flavor, target = ":_windows_" + flavor, frameworks = [framework])

def _library_probe(name, framework, scenario, deps, project_sdk = "default"):
    _windows_metadata(name = name + "_metadata", frameworks = [framework])
    csharp_binary(
        name = name + "_app",
        srcs = [
            "//eng/bazel/windows:LibraryProbe.cs",
            "//eng/bazel:GlobalUsings.cs",
            "//eng/bazel:RuntimeProvenance.cs",
            ":" + name + "_metadata",
        ],
        out = "TestFx.Bazel.WindowsProbe",
        target_frameworks = [framework],
        defines = ["WINDOWS_" + scenario.upper() + "_PROBE"],
        generate_documentation_file = False,
        langversion = "preview",
        nullable = "enable",
        treat_warnings_as_errors = True,
        nowarn = ["CS1701", "CS1702", "TPEXP", "TPINTERNAL", "MSTESTOBS"],
        project_sdk = project_sdk,
        deps = deps,
    )
    publish_binary(
        name = name + "_publish",
        binary = ":" + name + "_app",
        target_framework = framework,
        runtime_identifier = "win-x64",
        self_contained = True,
    )
    testfx_matrix(name = name, target = ":" + name + "_publish", frameworks = [framework])

def _controller():
    # This external extension ships net10/netstandard2.0 assets. Both controller
    # TFMs use netstandard2.0, but its released MTP dependency must not flow.
    package = "@windows_codecoverage_archive//:files"
    groups = {
        "managed": [
            "lib/netstandard2.0/" + name + ".dll"
            for name in [
                "Microsoft.CodeCoverage.Core",
                "Microsoft.CodeCoverage.Instrumentation.Core",
                "Microsoft.CodeCoverage.Instrumentation",
                "Microsoft.CodeCoverage.Interprocess",
                "Microsoft.Testing.Extensions.CodeCoverage",
                "Microsoft.VisualStudio.CodeCoverage.Shim",
            ]
        ],
        "resources": [
            "lib/netstandard2.0/" + culture + "/Microsoft.Testing.Extensions.CodeCoverage.resources.dll"
            for culture in ["cs", "de", "es", "fr", "hu", "it", "ja", "ko", "nl", "pl", "pt-BR", "pt-PT", "ru", "sv", "tr", "zh-Hans", "zh-Hant"]
        ],
        "native": [
            "runtimes/win-x64/native/" + name
            for name in [
                "CodeCoverageMessages.dll",
                "Cov_arm64.config",
                "Cov_x64.config",
                "Cov_x86.config",
                "MicrosoftInstrumentationEngine_arm64.dll",
                "MicrosoftInstrumentationEngine_x64.dll",
                "MicrosoftInstrumentationEngine_x86.dll",
                "covrun32.dll",
                "covrun64.dll",
                "covrunarm64.dll",
                "msdia140.dll",
            ]
        ],
        "nupkg": ["microsoft.testing.extensions.codecoverage." + _CODE_COVERAGE_VERSION + ".nupkg"],
    }
    for group, files in groups.items():
        _package_files(name = "windows_coverage_" + group, package = package, suffixes = files)
    import_library(
        name = "windows_code_coverage",
        library_name = "Microsoft.Testing.Extensions.CodeCoverage",
        version = _CODE_COVERAGE_VERSION,
        refs = [":windows_coverage_managed"],
        libs = [":windows_coverage_managed"],
        native = [":windows_coverage_native"],
        resource_assemblies = [":windows_coverage_resources"],
        nupkg = ":windows_coverage_nupkg",
        deps = [":platform"] + [
            "@windows.coverage//" + package
            for package in [
                "microsoft.diasymreader",
                "microsoft.extensions.dependencymodel",
                "mono.cecil",
                "system.reflection.metadata",
                "system.text.json",
                "microsoft.bcl.asyncinterfaces",
                "system.buffers",
                "system.io.pipelines",
                "system.memory",
                "system.runtime.compilerservices.unsafe",
                "system.text.encodings.web",
                "system.threading.tasks.extensions",
            ]
        ],
    )
    _windows_library(
        name = "windows_controller_app",
        project = "src/Platform/Microsoft.Testing.Extensions.PackagedApp.Controller",
        assembly_name = "mstest-appmodel-controller",
        target_frameworks = _PACKAGED_FRAMEWORKS[:2],
        binary = True,
        roll_forward_behavior = "LatestMajor",
        deps = [":platform", ":msbuild_extension", ":packaged_app_windows", ":trx", ":hangdump", ":retry", ":windows_code_coverage"],
    )
    controllers = []
    for framework in _PACKAGED_FRAMEWORKS[:2]:
        name = "windows_controller_" + framework.split(".")[0]
        publish_binary(
            name = name + "_publish",
            binary = ":windows_controller_app",
            target_framework = framework,
            runtime_identifier = "win-x64",
            self_contained = False,
            roll_forward_behavior = "LatestMajor",
        )
        testfx_matrix(name = name, target = ":" + name + "_publish", frameworks = [framework])
        controllers.append(":" + name)
    native.filegroup(name = "windows_controllers", srcs = controllers)

def windows_libraries():
    _projection("windows_sdk_19041", "sdk19041", "10.0.19041.57", "net8.0")
    _projection("windows_sdk_19041_net10", "sdk19041net10", "10.0.19041.87", "net9.0")
    _projection("windows_sdk_17763", "sdk17763", "10.0.17763.57", "net8.0")
    _projection("windows_sdk_18362", "sdk18362", "10.0.18362.57", "net8.0")

    for framework in _PACKAGED_FRAMEWORKS:
        native.config_setting(
            name = "windows_tfm_" + framework,
            flag_values = {"@rules_dotnet//dotnet:target_framework": framework},
        )
    native.alias(
        name = "windows_sdk_packaged",
        actual = select({
            ":windows_tfm_" + framework: ":windows_sdk_19041" if framework.split("-")[0] in ["net8.0", "net9.0"] else ":windows_sdk_19041_net10"
            for framework in _PACKAGED_FRAMEWORKS
        }),
    )

    _windows_library(
        name = "packaged_app_windows",
        project = _PACKAGED_APP,
        target_frameworks = _PACKAGED_FRAMEWORKS,
        defines = ["PACKAGEDAPP_WINRT"],
        linked_srcs = [
            _PLATFORM + "/Helpers/PasteArguments.cs",
            _SHARED + "/RetryArtifactManifest.cs",
            _SHARED + "/TestCaseFilterCommandLineOptionsProviderBase.cs",
        ],
        resources = {_PACKAGED_APP + "/Resources/ExtensionResources.resx": "Microsoft.Testing.Extensions.PackagedApp.Resources.ExtensionResources"},
        build_info = _SHARED + "/BuildInfo.cs.template",
        analyzer_configs = ["//eng/bazel/windows:winrt.globalconfig"],
        internals_visible_to = ["Microsoft.Testing.Extensions.UnitTests", "mstest-appmodel-controller"],
        deps = [":platform", ":windows_sdk_packaged"],
    )
    testfx_matrix(
        name = "packaged_app_windows_all",
        target = ":packaged_app_windows",
        frameworks = _PACKAGED_FRAMEWORKS,
    )

    _windows_library(
        name = "windows_ui_automation",
        project = _UI_AUTOMATION,
        assembly_name = "MSTest.Windows.UIAutomation",
        target_frameworks = _DESKTOP_FRAMEWORKS,
        project_sdk = "windowsdesktop",
        resources = {_UI_AUTOMATION + "/Resources/WindowsUIAutomationResources.resx": "Microsoft.VisualStudio.TestTools.UnitTesting.Windows.UIAutomation.Resources.WindowsUIAutomationResources"},
        deps = [":framework", ":framework_extensions"],
    )
    testfx_matrix(
        name = "windows_ui_automation_all",
        target = ":windows_ui_automation",
        frameworks = _DESKTOP_FRAMEWORKS,
    )

    _mstest_flavor("uwp", "net10.0-windows10.0.17763.0", "WINDOWS_UWP", [":windows_sdk_17763"])
    _mstest_flavor("winui", "net10.0-windows10.0.18362.0", "WIN_UI", [":windows_sdk_18362", "@windows.main//microsoft.windowsappsdk"])
    _controller()

    native.filegroup(
        name = "windows_libraries",
        srcs = [
            ":packaged_app_windows_all",
            ":windows_ui_automation_all",
            ":windows_uwp",
            ":windows_winui",
        ],
    )

    probes = []
    for framework in _PACKAGED_FRAMEWORKS:
        name = "windows_probe_packaged_" + framework.split(".")[0]
        _library_probe(name, framework, "packaged", [":packaged_app_windows", ":platform", ":windows_sdk_packaged"])
        probes.append(":" + name)
    _library_probe(
        "windows_probe_desktop",
        "net8.0-windows7.0",
        "desktop",
        [":windows_ui_automation", ":framework", ":framework_extensions"],
        project_sdk = "windowsdesktop",
    )
    _library_probe(
        "windows_probe_uwp",
        "net10.0-windows10.0.17763.0",
        "uwp",
        [":adapter_uwp", ":platform_services_uwp", ":framework_extensions_uwp", ":framework_uwp"],
    )
    _library_probe(
        "windows_probe_winui",
        "net10.0-windows10.0.18362.0",
        "winui",
        [":adapter_winui", ":platform_services_winui", ":framework_extensions_winui", ":framework_winui"],
    )
    native.filegroup(
        name = "windows_probes",
        srcs = probes + [":windows_probe_desktop", ":windows_probe_uwp", ":windows_probe_winui"],
    )

    _windows_metadata(name = "windows_app_model_metadata", frameworks = [_PACKAGED_FRAMEWORKS[0]])
    csharp_binary(
        name = "windows_app_model_host",
        srcs = [
            "//eng/bazel/windows:AppModelHost.cs",
            "//eng/bazel:GlobalUsings.cs",
            "//samples/public/TestingPlatformExamples/TestingPlatformExplorer:framework_sources",
            ":windows_app_model_metadata",
        ],
        out = "TestFx.Bazel.AppModelHost",
        target_frameworks = [_PACKAGED_FRAMEWORKS[0]],
        langversion = "preview",
        nullable = "enable",
        generate_documentation_file = False,
        deps = [":platform", ":packaged_app_windows", ":trx", ":trx_abstractions", ":retry", ":windows_sdk_packaged"],
    )
    publish_binary(
        name = "windows_app_model_publish",
        binary = ":windows_app_model_host",
        target_framework = _PACKAGED_FRAMEWORKS[0],
        runtime_identifier = "win-x64",
        self_contained = True,
    )
    testfx_matrix(name = "windows_app_model", target = ":windows_app_model_publish", frameworks = [_PACKAGED_FRAMEWORKS[0]])
