<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(SupportedNetFrameworks)</TargetFrameworks>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- Both supported TFMs reference the platform and verify duplicate public abstractions are removed
       from the shared-source set. -->
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src\Platform\Microsoft.Testing.Platform\Microsoft.Testing.Platform.csproj" />
  </ItemGroup>

  <!--
    The shared terminal-reporter contract types are [Microsoft.CodeAnalysis.Embedded], which resolves to a
    polyfill (not a framework type). The terminal source also needs the other src/Polyfills shims on down-level
    TFMs. We compile the polyfills here (not via a package reference) to mirror how an external consumer
    (e.g. dotnet/sdk) supplies them.
  -->
  <ItemGroup>
    <Compile Include="$(RepoRoot)src/Polyfills/**/*.cs" Link="Polyfills\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Compile the shared terminal reporter, rendering, state and TerminalResources.resx into this assembly.
    The platform's terminal reporter types are embedded and not exposed to this consumer; its public logging
    and color abstractions are supplied by the platform reference above. This project does not validate
    consumption without a platform reference.
  -->
  <Import Project="$(RepoRoot)src\Platform\Microsoft.Testing.Platform\OutputDevice\Terminal\TerminalReporterContract.props" />

</Project>
