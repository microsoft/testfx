{
  "tools": {
    "dotnet": "11.0.100-rc.2.26425.121",
    "runtimes": {
      "dotnet": [
        "8.0.29",
        "9.0.18",
        "10.0.10"
      ],
      "dotnet/x86": [
        "9.0.18",
        "10.0.10"
      ],
      "aspnetcore": [
        "9.0.18",
        "10.0.10"
      ]
    },
    "vs": {
      "version": "17.14.10",
      "components": [
        "Microsoft.VisualStudio.Workload.Universal"
      ]
    }
  },
  "sdk": {
    "version": "11.0.100-rc.2.26425.121",
    "paths": [
      ".dotnet",
      "$host$"
    ],
    "errorMessage": "The .NET SDK could not be found, please run ./build.cmd on Windows or ./build.sh on Linux and macOS.",
    "allowPrerelease": true,
    "rollForward": "latestFeature"
  },
  "test": {
    "runner": "Microsoft.Testing.Platform",
    "affectedTests": {
      "changes": {
        "ignore": [
          ".github/**",
          "docs/**",
          "**/*.md"
        ],
        "forceAllTests": [
          "global.json",
          "Directory.Build.*",
          "Directory.Packages.props",
          "NuGet.config",
          "TestFx.slnx",
          "*.slnf",
          "Build.cmd",
          "Test.cmd",
          "build.sh",
          "test.sh",
          "eng/**",
          "src/**/Directory.Build.*",
          "test/**/Directory.Build.*"
        ]
      },
      "instrumentation": {
        "include": [
          "src/**"
        ],
        "exclude": [
          "artifacts/**",
          "samples/**",
          "test/**",
          "**/bin/**",
          "**/obj/**"
        ]
      }
    }
  },
  "msbuild-sdks": {
    "Microsoft.DotNet.Arcade.Sdk": "11.0.0-beta.26431.4",
    "MSBuild.Sdk.Extras": "3.0.44"
  }
}
