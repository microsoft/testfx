{
  "stryker-config": {
    "solution": "MutationTesting.slnx",
    "test-runner": "mtp",
    "mutation-level": "Standard",
    "mutate": [
      "!**/obj/**",
      "!**/*.g.cs",
      "!**/*.generated.cs",
      "!**/*.Generated.cs"
    ],
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "break-on-initial-test-failure": true
  }
}
